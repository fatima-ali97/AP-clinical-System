<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Exclude duplicate jQuery assets that cause StaticWebAssets conflicts -->
    <StaticWebAsset Remove="wwwroot\lib\jquery\**\*" />
    <StaticWebAsset Remove="wwwroot\lib\jquery-validation-unobtrusive\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AP_clinical_system.Reporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
  </ItemGroup>

</Project>
