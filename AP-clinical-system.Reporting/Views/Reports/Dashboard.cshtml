@using System.Text.Json

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Manager Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var startDate = ViewBag.StartDate as string ?? DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd");
    var endDate = ViewBag.EndDate as string ?? DateTime.Now.ToString("yyyy-MM-dd");

    var appointmentStatsJson = ViewBag.AppointmentStatistics as string ?? "{}";
    var cancellationJson = ViewBag.CancellationAndNoShowRates as string ?? "{}";
    var specializationJson = ViewBag.AppointmentsBySpecialization as string ?? "{}";
    var workloadJson = ViewBag.DoctorWorkloadDistribution as string ?? "{}";
    var leaveJson = ViewBag.DoctorLeaveSummary as string ?? "{}";

    var totalAppointments = 0;
    var completedAppointments = 0;
    var cancelledAppointments = 0;
    var noShowAppointments = 0;

    var cancellationRate = 0.0;
    var noShowRate = 0.0;
    var combinedRate = 0.0;

    var totalDoctors = 0;
    var activeDoctors = 0;
    var avgAppointmentsPerDoctor = 0.0;

    var totalLeaveRecords = 0;
    var doctorsOnLeave = 0;

    try
    {
        var doc = JsonDocument.Parse(appointmentStatsJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalAppointments = summary.GetProperty("total").GetInt32();
        completedAppointments = summary.GetProperty("completed").GetInt32();
        cancelledAppointments = summary.GetProperty("cancelled").GetInt32();
        noShowAppointments = summary.GetProperty("noShow").GetInt32();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(cancellationJson);
        var overall = doc.RootElement.GetProperty("overall");

        cancellationRate = overall.GetProperty("cancellationRate").GetDouble();
        noShowRate = overall.GetProperty("noShowRate").GetDouble();
        combinedRate = overall.GetProperty("combinedRate").GetDouble();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(workloadJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalDoctors = summary.GetProperty("totalDoctors").GetInt32();
        activeDoctors = summary.GetProperty("activeDoctors").GetInt32();
        avgAppointmentsPerDoctor = summary.GetProperty("avgAppointmentsPerActiveDoctor").GetDouble();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(leaveJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalLeaveRecords = summary.GetProperty("totalLeaveRecords").GetInt32();
        doctorsOnLeave = summary.GetProperty("doctorsOnLeave").GetInt32();
    }
    catch { }
}


<h1 class="page-heading">Clinical Manager's Reporting Dashboard</h1>

<!-- Date filtering -->
<form method="get" asp-controller="Reports" asp-action="Dashboard" class="row dashboard-filter report-section">
    <div class="col-md-4">
        <label>Start Date</label>
        <input type="date" name="startDate" value="@startDate" class="form-control" />
    </div>

    <div class="col-md-4">
        <label>End Date</label>
        <input type="date" name="endDate" value="@endDate" class="form-control" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Load Reports
        </button>
    </div>
</form>

<!-- Export pdf -->
<div class="export-row">
    <button type="button" class="btn btn-primary" onclick="exportDashboardPdf()">
        <i class="fa-solid fa-file-pdf"></i>
        Export PDF
    </button>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div id="reportContent">

    <!--PDF Title -->
    <div class="pdf-report-title">
        <h2>Clinic Manager Report</h2>
        <p>From @startDate to @endDate</p>
    </div>

    <!-- Doctor Stats -->
    <div class="section-card report-section">
        <h5 class="card-title mb-4">Doctor Summary</h5>

        <div class="mini-card-row">

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-stethoscope"></i>
                    </div>
                    <div class="mini-card-label">Total Doctors</div>
                </div>
                <div class="mini-card-value">@totalDoctors</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>
                    <div class="mini-card-label">Active Doctors</div>
                </div>
                <div class="mini-card-value">@activeDoctors</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-plane-departure"></i>
                    </div>
                    <div class="mini-card-label">Doctors on Leave</div>
                </div>
                <div class="mini-card-value">@doctorsOnLeave</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-file-medical"></i>
                    </div>
                    <div class="mini-card-label">Leave Records</div>
                </div>
                <div class="mini-card-value">@totalLeaveRecords</div>
            </div>

        </div>
    </div>

    <!-- Appointment Stats -->
    <div class="section-card report-section">
        <h5 class="card-title mb-4">Appointment Summary</h5>

        <div class="mini-card-row">

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div class="mini-card-label">Total Appointments</div>
                </div>
                <div class="mini-card-value">@totalAppointments</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div class="mini-card-label">Completed</div>
                </div>
                <div class="mini-card-value">@completedAppointments</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>
                    <div class="mini-card-label">Cancelled</div>
                </div>
                <div class="mini-card-value">@cancelledAppointments</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-user-clock"></i>
                    </div>
                    <div class="mini-card-label">No Show</div>
                </div>
                <div class="mini-card-value">@noShowAppointments</div>
            </div>

        </div>

        <div class="mini-card-row">

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                    <div class="mini-card-label">Cancellation Rate</div>
                </div>
                <div class="mini-card-value">@cancellationRate%</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-user-slash"></i>
                    </div>
                    <div class="mini-card-label">No Show Rate</div>
                </div>
                <div class="mini-card-value">@noShowRate%</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-chart-simple"></i>
                    </div>
                    <div class="mini-card-label">Combined Rate</div>
                </div>
                <div class="mini-card-value">@combinedRate%</div>
            </div>

            <div class="mini-card">
                <div class="mini-card-title">
                    <div class="mini-card-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="mini-card-label">Avg. Appointments / Doctor</div>
                </div>
                <div class="mini-card-value">@avgAppointmentsPerDoctor</div>
            </div>

        </div>

    </div>


    <!-- Bar Charts -->
    <div class="chart-row-2">

        <div class="card report-card">
            <div class="card-header">
                <h5 class="card-title">Appointments Per Specialization</h5>
            </div>
            <div class="card-body">
                <canvas id="specializationChart" class="chart-large"></canvas>
            </div>
        </div>

        <!-- Doctor Workload Distribution -->
        <div class="card report-card">
            <div class="card-header">
                <h5 class="card-title">Doctor Workload Distribution</h5>
            </div>
            <div class="card-body">
                <canvas id="workloadChart" class="chart-large"></canvas>
            </div>
        </div>

    </div>

    <!-- Pie Charts-->
    <div class="chart-row-2">

        <!-- Appointment status stats -->
        <div class="card report-card">
            <div class="card-header">
                <h5 class="card-title">Appointments Status</h5>
            </div>
            <div class="card-body">
                <canvas id="appointmentStatusChart" class="chart-large"></canvas>
            </div>
        </div>

        <!-- Doctor leave types -->
        <div class="card report-card">
            <div class="card-header">
                <h5 class="card-title">Doctor Leave Types</h5>
            </div>
            <div class="card-body">
                <canvas id="leaveChart" class="chart-large"></canvas>
            </div>
        </div>

    </div>

    <!-- generation date -->
    <div class="report-generated-footer">
        Generated on @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")
    </div>

</div>

@section Scripts {
    <!-- importing JS charts library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        //getting data and saving them 
        const appointmentStats = @Html.Raw(appointmentStatsJson);
        const specializationStats = @Html.Raw(specializationJson);
        const workloadStats = @Html.Raw(workloadJson);
        const leaveStats = @Html.Raw(leaveJson);
        const appointmentSummary = appointmentStats.summary || {};

        Chart.register(ChartDataLabels);

        //colors used in the charts
        const colors = ['#2F647F', '#4A8199', '#75A8BA', '#A9CDD9', '#DCEBF0'];

        //options that are the same among overall charts
        const commonOptions = {
            responsive: true, //responsive
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    labels: { //labels options
                        color: '#52666f',
                        usePointStyle: true,
                        padding: 16
                    }
                }
            }
        };

        //bar charts grid
        const noGridScales = {
            x: {
                grid: {
                    display: false, //hide x axis grid
                    drawBorder: false
                },
                ticks: {
                    color: '#52666f' //x axis label
                }
            },
            y: {
                beginAtZero: true, //starting from 0
                grid: {
                    display: false, //hide y axis grid
                    drawBorder: false
                },
                ticks: {
                    color: '#52666f' //y axis label
                }
            }
        };

        //Spceialization Summary
        //take specializationStats.bySpecialization, if does't exist --> empty 
        const specializations = specializationStats.bySpecialization || [];

        const specializationChart = new Chart(document.getElementById('specializationChart'), { // draw chart in div with id = specializationChart
            type: 'bar', //Chart type
            data: {
                labels: specializations.map(x => x.specializationName), //labels 
                datasets: [{
                    data: specializations.map(x => x.totalAppointments), //data used
                    //bars config
                    backgroundColor: '#A9CDD9',
                    borderRadius: 10,
                    barThickness: 24
                }]
            },
            //options config
            options: {
                ...commonOptions,
                indexAxis: 'y',
                plugins: {
                    legend: {
                        display: false //remove legned
                    },
                    datalabels: {
                        display: false
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true, //start x axis from 0
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#52666f'
                        }
                    },
                    y: {
                        grid: {
                            display: false,
                            drawBorder: false
                        },
                        ticks: {
                            color: '#52666f'
                        }
                    }
                }
            }
        });

        //workloadStats
        //take workloadStats.doctorWorkloads, if does't exist --> empty
        const doctorWorkloads = workloadStats.doctorWorkloads || [];

        const workloadChart = new Chart(document.getElementById('workloadChart'), { // draw chart in div with id = workloadChart
            type: 'bar', //Chart type
            data: {
                labels: doctorWorkloads.map(x => x.doctorName), //x axis labels
                datasets: [{
                    data: doctorWorkloads.map(x => x.totalAppointments), //data used
                    //bars config
                    backgroundColor: '#A9CDD9',
                    borderRadius: 10,
                    barThickness: 26
                }]
            },
            //options config
            options: {
                ...commonOptions,
                plugins: {
                    legend: {
                        display: false
                    },
                    datalabels: {
                        display: false
                    }
                },
                scales: noGridScales
            }
        });

        //Appointment Status
        const appointmentStatusChart = new Chart(document.getElementById('appointmentStatusChart'), {// draw chart in div with id = appointmentStatusChart
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Cancelled', 'No Show'], //labels
                datasets: [{
                    data: [ //data used, if there is no data --> 0
                        appointmentSummary.completed || 0,
                        appointmentSummary.cancelled || 0,
                        appointmentSummary.noShow || 0
                    ],
                    //chart config
                    backgroundColor: ['#2F647F', '#75A8BA', '#DCEBF0'],
                    borderColor: '#ffffff',
                    borderWidth: 3
                }]
            },
            //options config
            options: {
                ...commonOptions,
                cutout: '62%', //center hole
                plugins: {
                    legend: {
                        position: 'bottom', //legend placement
                        labels: {
                            color: '#52666f', //labels colors
                            usePointStyle: true,
                            padding: 18
                        }
                    },
                    datalabels: {
                        color: '#ffffff',
                        font: {
                            weight: 'bold',
                            size: 12
                        },
                        formatter: function (value, context) {
                            var data = context.chart.data.datasets[0].data;
                            var total = data.reduce(function (sum, number) {
                                return sum + number;
                            }, 0);

                            if (total === 0 || value === 0) {
                                return '';
                            }

                            var percentage = (value / total * 100).toFixed(1);
                            return percentage + '%';
                        }
                    }
                }
            }
        });

        //take leaveStats.summary, if does't exist --> empty
        const leaveTypeBreakdown = leaveStats.summary?.leaveTypeBreakdown || [];

        const leaveChart = new Chart(document.getElementById('leaveChart'), {// draw chart in div with id = leaveChart
            type: 'doughnut', //chart type
            data: {
                labels: leaveTypeBreakdown.map(x => x.leaveType), //labels
                datasets: [{
                    data: leaveTypeBreakdown.map(x => x.count), //data used
                    //chart config
                    backgroundColor: colors,
                    borderColor: '#ffffff',
                    borderWidth: 3
                }]
            },
            //options config
            options: {
                ...commonOptions,
                cutout: '62%',
                //center hole
                plugins: {
                    legend: {
                        position: 'bottom', //legend placement
                        labels: {
                            color: '#52666f', //labels colors
                            usePointStyle: true,
                            padding: 18
                        }
                    },
                    datalabels: {
                        color: '#ffffff',
                        font: {
                            weight: 'bold',
                            size: 12
                        },
                        formatter: function (value, context) {
                            var data = context.chart.data.datasets[0].data;
                            var total = data.reduce(function (sum, number) {
                                return sum + number;
                            }, 0);

                            if (total === 0 || value === 0) {
                                return '';
                            }

                            var percentage = (value / total * 100).toFixed(1);
                            return percentage + '%';
                        }
                    }
                }
            }
        });

        const allCharts = [
            specializationChart,
            workloadChart,
            appointmentStatusChart,
            leaveChart
        ];

        /*export pdf function*/
        function exportDashboardPdf() {
            var pdf = document.getElementById("reportContent");

            //copy the report content
            var pdfCopy = pdf.cloneNode(true);
            pdfCopy.classList.add("pdf-exporting");

            //create centered pdf page
            var wrapper = document.createElement("div");
            wrapper.className = "pdf-page-wrapper";
            wrapper.appendChild(pdfCopy);

            //get original charts and copied charts
            var originalCharts = pdf.querySelectorAll("canvas");
            var copiedCharts = pdfCopy.querySelectorAll("canvas");

            //replace canvas charts with images
            originalCharts.forEach(function (canvas, index) {
                var image = document.createElement("img");

                image.src = canvas.toDataURL("image/png");

                if (canvas.id === "appointmentStatusChart" || canvas.id === "leaveChart") {
                    image.className = "chart-image pie-chart-image";
                }
                else {
                    image.className = "chart-image bar-chart-image";
                }

                copiedCharts[index].parentNode.replaceChild(image, copiedCharts[index]);
            });

            var opt = {
                margin: 0.15,
                filename: 'ClinicReport.pdf',
                image: {
                    type: 'jpeg',
                    quality: 0.98
                },
                html2canvas: {
                    scale: 2,
                    scrollY: 0,
                    useCORS: true,
                    backgroundColor: '#ffffff'
                },
                jsPDF: {
                    unit: 'in',
                    format: 'a4',
                    orientation: 'portrait'
                },
                pagebreak: {
                    mode: ['avoid-all', 'css']
                }
            };

            html2pdf()
                .set(opt)
                .from(wrapper)
                .save();
        }

    </script>
}