@using System.Text.Json

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Manager Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var startDate = ViewBag.StartDate as string ?? DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd");
    var endDate = ViewBag.EndDate as string ?? DateTime.Now.ToString("yyyy-MM-dd");

    var appointmentStatsJson = ViewBag.AppointmentStatistics as string ?? "{}";
    var cancellationJson = ViewBag.CancellationAndNoShowRates as string ?? "{}";
    var specializationJson = ViewBag.AppointmentsBySpecialization as string ?? "{}";
    var workloadJson = ViewBag.DoctorWorkloadDistribution as string ?? "{}";
    var leaveJson = ViewBag.DoctorLeaveSummary as string ?? "{}";

    var totalAppointments = 0;
    var completedAppointments = 0;
    var cancelledAppointments = 0;
    var noShowAppointments = 0;

    var cancellationRate = 0.0;
    var noShowRate = 0.0;
    var combinedRate = 0.0;

    var totalDoctors = 0;
    var activeDoctors = 0;
    var avgAppointmentsPerDoctor = 0.0;

    var totalLeaveRecords = 0;
    var doctorsOnLeave = 0;

    try
    {
        var doc = JsonDocument.Parse(appointmentStatsJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalAppointments = summary.GetProperty("total").GetInt32();
        completedAppointments = summary.GetProperty("completed").GetInt32();
        cancelledAppointments = summary.GetProperty("cancelled").GetInt32();
        noShowAppointments = summary.GetProperty("noShow").GetInt32();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(cancellationJson);
        var overall = doc.RootElement.GetProperty("overall");

        cancellationRate = overall.GetProperty("cancellationRate").GetDouble();
        noShowRate = overall.GetProperty("noShowRate").GetDouble();
        combinedRate = overall.GetProperty("combinedRate").GetDouble();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(workloadJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalDoctors = summary.GetProperty("totalDoctors").GetInt32();
        activeDoctors = summary.GetProperty("activeDoctors").GetInt32();
        avgAppointmentsPerDoctor = summary.GetProperty("avgAppointmentsPerActiveDoctor").GetDouble();
    }
    catch { }

    try
    {
        var doc = JsonDocument.Parse(leaveJson);
        var summary = doc.RootElement.GetProperty("summary");

        totalLeaveRecords = summary.GetProperty("totalLeaveRecords").GetInt32();
        doctorsOnLeave = summary.GetProperty("doctorsOnLeave").GetInt32();
    }
    catch { }
}

<h1 class="page-heading">Clinical Manager's Reporting Dashboard</h1>

<form method="get" asp-controller="Reports" asp-action="Dashboard" class="row mb-4">
    <div class="col-md-4">
        <label>Start Date</label>
        <input type="date" name="startDate" value="@startDate" class="form-control" />
    </div>

    <div class="col-md-4">
        <label>End Date</label>
        <input type="date" name="endDate" value="@endDate" class="form-control" />
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
            Load Reports
        </button>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<!-- STAT CARDS -->
<div class="stat-grid admin">

    <div class="card stat-card">
        <div class="card-body" style="background: #7a97b8;">
            <span class="tri-bl"></span>
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Total Doctors</div>
                    <div class="stat-value">@totalDoctors</div>
                </div>
                <div class="stat-icon" style="background: #c8d9eb;">
                    <i class="fa-solid fa-stethoscope" style="color: #3a5f8a;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #5e9fa8;">
            <span class="tri-bl"></span>
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Active Doctors</div>
                    <div class="stat-value">@activeDoctors</div>
                </div>
                <div class="stat-icon" style="background-color: #b0d8de;">
                    <i class="fa-solid fa-user-doctor" style="color: #205a64;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #9080b8;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Total Appointments</div>
                    <div class="stat-value">@totalAppointments</div>
                </div>
                <div class="stat-icon" style="background-color: #ccc0e0;">
                    <i class="fa-solid fa-calendar-days" style="color: #4a3480;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background-color: #c4975a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Completed</div>
                    <div class="stat-value">@completedAppointments</div>
                </div>
                <div class="stat-icon" style="background-color: #e8d0a8;">
                    <i class="fa-solid fa-calendar-check" style="color: #7a5020;"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="stat-grid admin mt-4">

    <div class="card stat-card">
        <div class="card-body" style="background: #b86f6f;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Cancelled</div>
                    <div class="stat-value">@cancelledAppointments</div>
                </div>
                <div class="stat-icon" style="background-color: #e7bcbc;">
                    <i class="fa-solid fa-calendar-xmark" style="color: #7a2d2d;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #a86f8d;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">No Show</div>
                    <div class="stat-value">@noShowAppointments</div>
                </div>
                <div class="stat-icon" style="background-color: #dfbfd0;">
                    <i class="fa-solid fa-user-clock" style="color: #6b2b4c;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #6f9f7a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Doctors on Leave</div>
                    <div class="stat-value">@doctorsOnLeave</div>
                </div>
                <div class="stat-icon" style="background-color: #c2dfc7;">
                    <i class="fa-solid fa-plane-departure" style="color: #2f6b3b;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #6f88a8;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Leave Records</div>
                    <div class="stat-value">@totalLeaveRecords</div>
                </div>
                <div class="stat-icon" style="background-color: #c2d2e6;">
                    <i class="fa-solid fa-file-medical" style="color: #304f78;"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- GRAPHS -->
<div class="bottom-grid mt-4">

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Appointment Status</h5>
        </div>
        <div class="card-body">
            <canvas id="appointmentStatusChart"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Cancellation / No Show Rates</h5>
        </div>
        <div class="card-body">
            <canvas id="ratesChart"></canvas>
        </div>
    </div>

</div>

<div class="bottom-grid mt-4">

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Appointments by Specialization</h5>
        </div>
        <div class="card-body">
            <canvas id="specializationChart"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Doctor Workload Distribution</h5>
        </div>
        <div class="card-body">
            <canvas id="workloadChart"></canvas>
        </div>
    </div>

</div>

<div class="bottom-grid mt-4">

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Doctor Leave Types</h5>
        </div>
        <div class="card-body">
            <canvas id="leaveChart"></canvas>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Summary</h5>
        </div>
        <div class="card-body">
            <h4>Cancellation Rate: @cancellationRate%</h4>
            <h4>No Show Rate: @noShowRate%</h4>
            <h4>Combined Rate: @combinedRate%</h4>
            <hr />
            <h4>Average Appointments Per Active Doctor</h4>
            <h2>@avgAppointmentsPerDoctor</h2>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const appointmentStats = @Html.Raw(appointmentStatsJson);
        const cancellationStats = @Html.Raw(cancellationJson);
        const specializationStats = @Html.Raw(specializationJson);
        const workloadStats = @Html.Raw(workloadJson);
        const leaveStats = @Html.Raw(leaveJson);

        //Appointment Status Chart
        const appointmentSummary = appointmentStats.summary || {};

        new Chart(document.getElementById('appointmentStatusChart'), {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Cancelled', 'No Show'],
                datasets: [{
                    data: [
                        appointmentSummary.completed || 0,
                        appointmentSummary.cancelled || 0,
                        appointmentSummary.noShow || 0
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        //Cancellation / No Show Rates
        const overallRates = cancellationStats.overall || {};

        new Chart(document.getElementById('ratesChart'), {
            type: 'bar',
            data: {
                labels: ['Cancellation Rate', 'No Show Rate', 'Combined Rate'],
                datasets: [{
                    label: 'Rate %',
                    data: [
                        overallRates.cancellationRate || 0,
                        overallRates.noShowRate || 0,
                        overallRates.combinedRate || 0
                    ]
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        //Appointments by Specialization
        const specializations = specializationStats.bySpecialization || [];

        new Chart(document.getElementById('specializationChart'), {
            type: 'bar',
            data: {
                labels: specializations.map(x => x.specializationName),
                datasets: [{
                    label: 'Appointments',
                    data: specializations.map(x => x.totalAppointments)
                }]
            },
            options: {
                responsive: true,
                indexAxis: 'y',
                scales: {
                    x: {
                        beginAtZero: true
                    }
                }
            }
        });

        //Doctor Workload Distribution
        const doctorWorkloads = workloadStats.doctorWorkloads || [];

        new Chart(document.getElementById('workloadChart'), {
            type: 'bar',
            data: {
                labels: doctorWorkloads.map(x => x.doctorName),
                datasets: [{
                    label: 'Total Appointments',
                    data: doctorWorkloads.map(x => x.totalAppointments)
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        //Doctor Leave Types
        const leaveTypeBreakdown = leaveStats.summary?.leaveTypeBreakdown || [];

        new Chart(document.getElementById('leaveChart'), {
            type: 'pie',
            data: {
                labels: leaveTypeBreakdown.map(x => x.leaveType),
                datasets: [{
                    data: leaveTypeBreakdown.map(x => x.count)
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}