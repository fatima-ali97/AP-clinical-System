@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Error";
    int code = ViewBag.StatusCode ?? 500;
}

<div style="text-align:center; padding: 80px 20px;">
    <h1 style="font-size: 6rem; font-weight: 700; color: var(--color-primary);">@code</h1>
    <h2>Oops!</h2>
    <p style="color: var(--color-text-tertiary); margin: 16px 0 32px;">
        @ViewBag.Message
    </p>
    <a href="/" class="hpd-btn">Go Home</a>
</div>