@using Microsoft.AspNetCore.Identity
@using AP_clinical_system.Models.Entities
@inject UserManager<system_user> UserManager
@using AP_clinical_system.Services
@{
    @* Dynamically determine navigation based on user role or current controller context *@
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var role = "Patient";
    
    if (User.IsInRole("Receptionist") || currentController == "Receptionist")
    {
        role = "Receptionist";
    }
    else if (User.IsInRole("Doctor") || currentController == "Doctor")
    {
        role = "Doctor";
    }
    var items = NavigationService.GetNavForRole(role);
    var activePage = ViewData["ActivePage"]?.ToString();
}

<ul class="sidebar-nav">
    @foreach (var item in items)
    {
        <li class="sidebar-item @(activePage == item.Label ? "active" : "")">
            <a class="sidebar-link" asp-controller="@item.Controller" asp-action="@item.Action">
                <i class="@item.Icon"></i> @item.Label
            </a>
            <div class="arrow">›</div>
        </li>
    }
</ul>