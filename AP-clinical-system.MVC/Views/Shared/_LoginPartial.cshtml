
@using Microsoft.AspNetCore.Identity

    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <li class="nav-item">
        <a class="nav-link text-dark mx-2" asp-action="Register" asp-controller="Account">Register</a>
        </li>

        <li class="nav-item">
        <a class="nav-link text-dark mx-2" asp-action="Login" asp-controller="Account">Login</a>
        </li>
    }