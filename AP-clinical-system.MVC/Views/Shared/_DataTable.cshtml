@{
    var tableId = (ViewData["DT_TableId"] as string) ?? "dataTable";
    var pageLen = (ViewData["DT_PageLength"] as int?) ?? 10;

    
}

<div class="card">
    <div class="card-header">
        <h5 class="card-title">@ViewData["DT_Title"]</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="@tableId" class="dt-container table table-hover table-striped align-middle mb-0 datatable-ap"
                   style="width:100%">
                @RenderSection("DT_Head", required: false)
                @RenderSection("DT_Body", required: false)
            </table>
        </div>
    </div>
</div>

<script>
    $(function () {
        $('#@tableId').DataTable({
            pageLength: @pageLen,
            language: {
                search: "",
                searchPlaceholder: "Search…",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_–_END_ of _TOTAL_",
                paginate: {
                    previous: "‹",
                    next: "›"
                }
            },
            columnDefs: [
                { orderable: false, targets: -1 }
            ]
        });
    });
</script>