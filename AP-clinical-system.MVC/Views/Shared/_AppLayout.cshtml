@using AP_clinical_system.Services
@using AP_clinical_system.Models.sql_Context
@using Microsoft.AspNetCore.Identity;
@inject AP_Context _context;

@inject UserManager<AP_clinical_system.Models.Entities.system_user> UserManager ;

@{
    ViewBag.DevRole = "Patient";

    string initials = "?";

    if (User.Identity?.IsAuthenticated ?? false)
    {
        var currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null)
        {
            var first = !string.IsNullOrEmpty(currentUser.first_name)
                ? currentUser.first_name.Substring(0, 1).ToUpper()
                : "";

            var last = !string.IsNullOrEmpty(currentUser.last_name)
                ? currentUser.last_name.Substring(0, 1).ToUpper()
                : "";

            initials = first + last;

            if (string.IsNullOrEmpty(initials))
            {
                initials = "?";
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.5.1/moment.min.js"></script>
    <script src="https://kit.fontawesome.com/5544d11b5b.js" crossorigin="anonymous"></script>

  
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>


    <link rel="stylesheet" href="~/css/app/AppLayout.css">
    <link rel="stylesheet" href="~/css/app/app.css">
    <link rel="stylesheet" href="~/css/components/datatable-custom.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">


    <title>@ViewData["Title"] - AdvancedHealth</title>
    @RenderSection("Styles", required: false)
</head>

<body>



    <div class="page-wrapper">

        <!-- Mobile overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- ── SIDEBAR ── -->
        <nav class="sidebar" id="sidebar">

            <a class="sidebar-brand" href="/">AdvancedHealth</a>


            @await Html.PartialAsync("_Navigation")

            
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> <span style="margin: 5px;">Log Out</span>
                </button>
            </form>

            
        </nav>

        <!-- ── MAIN AREA ── -->
        <div class="main-area" id="mainArea">

            <!-- Topbar -->
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                    <span></span><span></span><span></span>
                </button>

                <div class="topbar-right">
                    @* Notification bell TODO: to be decided later
                <a class="nav-icon-btn" href="#" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="badge-dot"></span>
                </a>
                *@
                    <a class="user-pill" href="#">
                        <div class="user-pill-avatar">
                            @initials
                        </div>
                    </a>
                </div>
            </header>

            <!-- Page content -->
            <main class="content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer">
                <span>&copy; @DateTime.Now.Year <a href="#">AdvancedHealth</a></span>
                <div class="footer-links">
                    @* <a href="#">Support</a> *@
                </div>
            </footer>

        </div><!-- /main-area -->
    </div><!-- /page-wrapper -->


    <script>
        (function () {
        var sidebar = document.getElementById('sidebar');
        var mainArea = document.getElementById('mainArea');
        var toggle = document.getElementById('sidebarToggle');
        var overlay = document.getElementById('sidebarOverlay');
        var isMobile = function () { return window.innerWidth < 992; };

        function openSidebar() {
        if (isMobile()) {
        sidebar.classList.add('open');
        overlay.classList.add('active');
        } else {
        sidebar.classList.remove('collapsed');
        mainArea.classList.remove('expanded');
        }
        }

        function closeSidebar() {
        if (isMobile()) {
        sidebar.classList.remove('open');
        overlay.classList.remove('active');
        } else {
        sidebar.classList.add('collapsed');
        mainArea.classList.add('expanded');
        }
        }

        function isOpen() {
        return isMobile()
        ? sidebar.classList.contains('open')
        : !sidebar.classList.contains('collapsed');
        }

        toggle.addEventListener('click', function () {
        isOpen() ? closeSidebar() : openSidebar();
        });

        overlay.addEventListener('click', closeSidebar);

        window.addEventListener('resize', function () {
        if (!isMobile()) {
        overlay.classList.remove('active');
        sidebar.classList.remove('open');
        }
        });
        })();
    </script>
    <script>
        $(function () {
        $('table.ap-datatable').each(function () {
        var pageLen = parseInt($(this).data('page-length') || 10);
        var sortCol = parseInt($(this).data('sort-col') ?? 0);

        $(this).DataTable({
        pageLength: pageLen,
        order: [[sortCol, 'desc']],
        language: {
        search: "",
        searchPlaceholder: "Search…",
        lengthMenu: "Show _MENU_ entries",
        info: "Showing _START_–_END_ of _TOTAL_",
        paginate: { previous: "‹", next: "›" }
        },
        columnDefs: [
        { orderable: false, targets: -1 }
        ]
        });
        });
        });
    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const errorMsg = '@(TempData["Error"] ?? "")';
            const successMsg = '@(TempData["Success"] ?? "")';
            
            if (errorMsg && errorMsg.length > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: errorMsg,
                    confirmButtonColor: '#0f172a' // --color-slate-900
                });
            }
            if (successMsg && successMsg.length > 0) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: successMsg,
                    confirmButtonColor: '#0f172a'
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>