<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinical System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; overflow-x: hidden; }
        .public-nav { 
            position: absolute; width: 100%; top: 0; z-index: 1000; padding: 20px 0; 
            background: transparent; transition: 0.3s;
        }
        .public-nav.scrolled { background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.1); padding: 10px 0; }
        .public-nav.scrolled .nav-link, .public-nav.scrolled .navbar-brand { color: #1e293b !important; }
        
        .navbar-brand { font-weight: 800; font-size: 1.5rem; color: white !important; }
        .nav-link { color: rgba(255,255,255,0.8) !important; font-weight: 500; margin: 0 10px; }
        .nav-link:hover { color: white !important; }
        
        .footer { padding: 40px 0; background: #0f172a; color: #94a3b8; font-size: 0.9rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg public-nav" id="mainNav">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-stethoscope me-2"></i>AP CLINICAL
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a></li>
                    <li class="nav-item"><a class="btn btn-primary px-4 ms-lg-3" asp-controller="Account" asp-action="Register">Register</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container text-center">
            <p class="mb-2">&copy; 2026 - AP Clinical Management System</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#" class="text-muted"><i class="fab fa-twitter"></i></a>
                <a href="#" class="text-muted"><i class="fab fa-facebook"></i></a>
                <a href="#" class="text-muted"><i class="fab fa-linkedin"></i></a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.onscroll = function() {
            var nav = document.getElementById('mainNav');
            if (window.pageYOffset > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
