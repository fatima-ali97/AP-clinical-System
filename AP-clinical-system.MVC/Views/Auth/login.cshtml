@model AP_clinical_system.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<partial name="_LoadingOverlay" />

<div class="login-page">
    <div class="login-card shadow">
        <h2 class="text-center mb-4">AdvancedHealth Login</h2>

        <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">

            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <button type="submit" class="btn btn-primary w-100 mt-2" id="btnSubmit">
                Login
            </button>

            <div class="text-center mt-3">
                <a asp-action="Register" asp-controller="Account" class="register-link">
                    Create new account
                </a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(function () {
            $('#loginForm').on('submit', function () {
                if ($(this).valid()) {
                    $('#blockui-overlay').css('display', 'flex');
                    $('#btnSubmit').prop('disabled', true).text('Please wait...');
                }
            });
        });
    </script>
}