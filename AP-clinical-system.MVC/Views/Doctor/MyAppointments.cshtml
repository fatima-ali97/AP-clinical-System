@{
    Layout = "_AppLayout";
    ViewData["Title"] = "My Appointments";
    ViewData["ActivePage"] = "My Appointments";
    var currentFilter = ViewBag.Filter as string ?? "all";
}

<h1 class="page-heading">My Appointments</h1>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "all" ? "active" : "")" href="@Url.Action("MyAppointments", "Doctor", new { filter = "all" })">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "upcoming" ? "active" : "")" href="@Url.Action("MyAppointments", "Doctor", new { filter = "upcoming" })">Upcoming</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentFilter == "completed" ? "active" : "")" href="@Url.Action("MyAppointments", "Doctor", new { filter = "completed" })">Completed</a>
    </li>
</ul>

<div class="card mt-4">
    <div class="card-body p-0">
        @await Html.PartialAsync("_DoctorIndexAppointments", null, new ViewDataDictionary(ViewData) { { "DT_TableId", "myApptTable" }, { "DT_Title", "My Appointments" } })
    </div>
</div>

@await Html.PartialAsync("_ChangeAppointmentStatusModal")
@await Html.PartialAsync("_AddVisitRecordModal")
@await Html.PartialAsync("_AddPrescriptionModal")
