@using AP_clinical_system.Models.Entities
@using AP_clinical_system.Models.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Patient Details";
    ViewData["ActivePage"] = "Patients";

    var patientInfo = ViewBag.PatientInfo as patient_information;
    var profileUser = ViewBag.ProfileUser as system_user;
    var prescriptions = ViewBag.Prescriptions as List<prescription> ?? new();
    var appointments = ViewBag.Appointments as List<appointment> ?? new();
    var doctorSchedule = ViewBag.DoctorSchedule as doctor_schedule;

    var patientUserMap = ViewBag.PatientUserMap as Dictionary<Guid, system_user> ?? new();
    var doctorUserMap = ViewBag.DoctorUserMap as Dictionary<Guid, system_user> ?? new();
    var doctorToUserMapping = ViewBag.DoctorToUserMapping as Dictionary<Guid, Guid> ?? new();

    static string StatusBadge(int? status) => status switch
    {
        (int)appointment_status.completed => "badge-success",
        (int)appointment_status.cancelled => "badge-danger",
        (int)appointment_status.no_show => "badge-danger",
        (int)appointment_status.in_progress => "badge-warning",
        (int)appointment_status.confirmed => "badge-info",
        (int)appointment_status.checked_in => "badge-info",
        _ => "badge-secondary"
    };

    static string StatusLabel(int? status) => status switch
    {
        (int)appointment_status.completed => "Completed",
        (int)appointment_status.cancelled => "Cancelled",
        (int)appointment_status.no_show => "No Show",
        (int)appointment_status.in_progress => "In Progress",
        (int)appointment_status.confirmed => "Confirmed",
        (int)appointment_status.checked_in => "Checked In",
        (int)appointment_status.requested => "Requested",
        _ => "Unknown"
    };

    static string SlotToTime(int? slot)
    {
        if (slot == null) return "TBD";
        int minutes = (slot.Value - 1000) * 30;
        int hour = 8 + minutes / 60;
        int min = minutes % 60;
        return new DateTime(2000, 1, 1, hour, min, 0).ToString("hh:mm tt");
    }

    bool CanConfirm(int? status) => status == (int)appointment_status.requested;
    bool CanCheckIn(int? status) => status == (int)appointment_status.confirmed;
    bool CanReschedule(int? status) => status == (int)appointment_status.requested || status == (int)appointment_status.confirmed;
    bool CanNoShow(int? status) => status == (int)appointment_status.confirmed;
    bool CanCancel(int? status) => status == (int)appointment_status.requested || status == (int)appointment_status.confirmed;
}

@section Styles
{
    <link href="~/css/app/app.css" rel="stylesheet" />
    <link href="~/css/components/Forms.css" rel="stylesheet" />
    <link href="~/css/app/ProfileCard.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/js/components/custom-dataTable.js"></script>
    <script src="~/js/components/ProfileCard.js"></script>
}

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">Patient Profile</h5>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_ProfileCard", null, new ViewDataDictionary(ViewData) { { "HideEditProfile", true } })
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">Prescriptions</h5>
            </div>
            <div class="card-body">
                @if (prescriptions.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in prescriptions)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@p.medicine_name</strong>
                                    <div class="text-muted small">@p.medicine_dosage - @p.medicine_frequency_duration</div>
                                </div>
                                <span>@p.createdon.ToString("dd MMM yyyy")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">No prescriptions found.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title">Visit History</h5>
            </div>
            <div class="card-body p-0">
                <div class="appt-card">
                    <div style="overflow-x: auto;">
                        @await Html.PartialAsync("_DoctorPatientDetailsAppointmentsTable", null, new ViewDataDictionary(ViewData) { { "DT_TableId", "pdApptTable" }, { "DT_Title", "" } })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ChangeAppointmentStatusModal")
@await Html.PartialAsync("_AddVisitRecordModal")
@await Html.PartialAsync("_AddPrescriptionModal")
