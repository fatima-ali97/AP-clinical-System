@using AP_clinical_system.Models.Entities
@using AP_clinical_system.Models
@inject AP_clinical_system.Models.sql_Context.AP_Context _context
@{
    Layout = "~/Views/Shared/_DataTable.cshtml";
    var prescriptions = ViewBag.Prescriptions as List<prescription> ?? new();
}

@section DT_Head {
    <thead>
        <tr>
            <th>Date</th>
            <th>Patient</th>
            <th>Medicine</th>
            <th>Dosage</th>
            <th>Frequency</th>
        </tr>
    </thead>
}

@section DT_Body {
    <tbody>
        @foreach (var p in prescriptions)
        {
            <tr>
                <td>@p.createdon.ToString("dd MMM yyyy")</td>
                <td><a href='@Url.Action("PatientDetails", "Doctor", new { id = p.patient_ref })' class="text-decoration-none">@(p.patient_ref.HasValue ? GeneralHelper.GetUserFullNameByID(_context, p.patient_ref.Value) : "N/A")</a></td>
                <td>@p.medicine_name</td>
                <td>@p.medicine_dosage</td>
                <td>@p.medicine_frequency_duration</td>
            </tr>
        }
    </tbody>
}
