@model AP_clinical_system.Models.Entities.visit_record

<div class="appt-backdrop" id="addVisitRecordModalBackdrop">
    <div class="appt-modal" id="addVisitRecordModal" role="dialog" aria-modal="true" aria-labelledby="addVisitRecordModalLabel">
        <div class="appt-modal-header" style="background-color: var(--color-slate-100, #f1f5f9); color: var(--color-slate-800, #1e293b); border-bottom: 1px solid var(--color-slate-200, #e2e8f0);">
            <h5 id="addVisitRecordModalLabel">Add Visit Record</h5>
            <button type="button" class="appt-close-btn" id="addVisitRecordCloseBtn" style="color: var(--color-slate-800, #1e293b);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="appt-modal-body py-4 px-3">
            <form asp-action="AddVisitRecord" asp-controller="Doctor" method="post">
                <input type="hidden" id="visitApptId" name="appointment_ref" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Diagnosis</label>
                    <input type="text" class="form-control" name="diagnosis" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Prescribed Treatment</label>
                    <textarea class="form-control" name="prescribed_treatment" rows="3" required></textarea>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Doctor Notes</label>
                    <textarea class="form-control" name="doctor_notes" rows="3"></textarea>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary fw-bold" id="addVisitRecordCancelBtn">Close</button>
                    <button type="submit" class="btn btn-primary fw-bold">Save Visit Record</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const backdrop = document.getElementById('addVisitRecordModalBackdrop');
        const closeBtn = document.getElementById('addVisitRecordCloseBtn');
        const cancelBtn = document.getElementById('addVisitRecordCancelBtn');

        function openModal(apptId) {
            document.getElementById('visitApptId').value = apptId;
            backdrop.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            backdrop.classList.remove('open');
            document.body.style.overflow = '';
        }

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
        if (backdrop) backdrop.addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-bs-target="#addVisitRecordModal"]');
            if (btn) {
                e.preventDefault();
                openModal(btn.getAttribute('data-appt-id'));
            }
        });
    });
</script>
