@using AP_clinical_system.Models.Enums

<div class="appt-backdrop" id="statusModalBackdrop">
    <div class="appt-modal" id="statusModal" role="dialog" aria-modal="true" aria-labelledby="statusModalTitle">
        <div class="appt-modal-header" style="background-color: var(--color-slate-100, #f1f5f9); color: var(--color-slate-800, #1e293b); border-bottom: 1px solid var(--color-slate-200, #e2e8f0);">
            <h5 id="statusModalTitle">Manage Pending Appointment</h5>
            <button type="button" class="appt-close-btn" id="statusCloseBtn" style="color: var(--color-slate-800, #1e293b);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>

        <div class="appt-modal-body py-4">
            <h4 id="statusPatientName" class="mb-2 fw-bold text-center" style="color: var(--color-slate-900);">Patient Name</h4>
            <div class="mb-4 text-center">
                <span class="badge" style="background-color: var(--color-slate-200); color: var(--color-slate-800); font-size: 0.9rem;">
                    Status: Requested
                </span>
            </div>

            <!-- Full Details container -->
            <div id="statusApptInfo" class="mb-4" style="background: var(--color-slate-50); padding: 1rem; border-radius: 8px; border: 1px solid var(--color-slate-200);">
                <p class="appt-slot-hint text-center">Loading details…</p>
            </div>

            <p class="text-muted mb-4 text-center">Please select an action for this requested appointment.</p>
            
            <div class="d-flex flex-column gap-2 px-3">
            @*     <form asp-controller="Receptionist" asp-action="ConfirmAppointment" method="post" id="formConfirmStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appointment_id" id="statusApptIdConfirm" />
                    <button type="submit" class="btn btn-success w-100 fw-bold" style="background-color: #2e7d55; border: none;">Approve & Confirm</button>
                </form>

                <button type="button" class="btn btn-warning w-100 fw-bold" id="statusRescheduleBtn" style="background-color: #f59e0b; border: none; color: #1e293b;">
                    Reschedule Appointment
                </button>

                <form asp-controller="Receptionist" asp-action="CancelAppointment" method="post" id="formCancelStatus" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appointment_id" id="statusApptIdCancel" />
                    <button type="button" class="btn btn-outline-danger w-100" id="statusCancelActionBtn">Cancel Appointment</button>
                </form>
                *@ 
            </div> 
        </div>
    </div>
</div>

<script>
    (function () {
        function openStatusModal(apptId, patientName, doctorUserId) {
            document.getElementById('statusApptIdConfirm').value = apptId;
            document.getElementById('statusApptIdCancel').value = apptId;
            document.getElementById('statusPatientName').textContent = patientName || 'Unknown Patient';
            
            // Store dataset for reschedule handoff
            const reschBtn = document.getElementById('statusRescheduleBtn');
            reschBtn.dataset.apptId = apptId;
            reschBtn.dataset.doctorUserId = doctorUserId;

            document.getElementById('statusModalBackdrop').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeStatusModal() {
            document.getElementById('statusModalBackdrop').classList.remove('open');
            document.body.style.overflow = '';
        }

        document.getElementById('statusCloseBtn')?.addEventListener('click', closeStatusModal);
        document.getElementById('statusModalBackdrop')?.addEventListener('click', function (e) {
            if (e.target === this) closeStatusModal();
        });

        function apptSlotToTime(sv) {
            const mins = (sv - 1000) * 30;
            const h = 8 + Math.floor(mins / 60);
            const m = mins % 60;
            const p = h >= 12 ? 'PM' : 'AM';
            const dh = h > 12 ? h - 12 : (h === 0 ? 12 : h);
            return `${String(dh).padStart(2, '0')}:${String(m).padStart(2, '0')} ${p}`;
        }

        async function loadStatusApptInfo(apptID) {
            const grid = document.getElementById('statusApptInfo');
            grid.innerHTML = '<p class="appt-slot-hint text-center">Loading details…</p>';
            try {
                const res = await fetch('/Appointments/GetAppointmentInfo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `apptID=${encodeURIComponent(apptID)}`
                });
                if (!res.ok) {
                    grid.innerHTML = '<p class="text-center text-danger">Appointment details could not be loaded.</p>';
                    return;
                }
                const d = await res.json();
                grid.innerHTML = `
                    <div style="display:flex; justify-content:space-between; margin-bottom: 8px;"><strong>Date:</strong> <span>${d.date ?? '—'}</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 8px;"><strong>Time:</strong> <span>${apptSlotToTime(d.time_slot)}</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 8px;"><strong>Doctor:</strong> <span>${d.doctor_name}</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 8px;"><strong>Specialization:</strong> <span>${d.specialization}</span></div>
                    <div style="display:flex; justify-content:space-between; margin-bottom: 8px;"><strong>Reason:</strong> <span>${d.reason ?? '—'}</span></div>
                `;
            } catch (err) {
                grid.innerHTML = `<p class="text-center text-danger">Error: ${err.message}</p>`;
            }
        }

        // Add a global listener so we can open it from calendar
        document.addEventListener('click', function (e) {
            const reqBtn = e.target.closest('.status-requested-trigger');
            if (reqBtn) {
                e.preventDefault();
                openStatusModal(reqBtn.dataset.apptId, reqBtn.dataset.patientName, reqBtn.dataset.doctorUserId);
                loadStatusApptInfo(reqBtn.dataset.apptId);
            }
        });

        // Wire up Reschedule Handoff
        document.getElementById('statusRescheduleBtn')?.addEventListener('click', function() {
            closeStatusModal();
            // Assuming openRescheduleModal is global from _RescheduleAppointmentForm.cshtml
            if (typeof openRescheduleModal === 'function') {
                openRescheduleModal(this.dataset.apptId, this.dataset.doctorUserId);
            }
        });

        // Wire up Cancel verification
        document.getElementById('statusCancelActionBtn')?.addEventListener('click', function() {
            Swal.fire({
                title: 'Cancel Appointment?',
                text: 'Are you sure you want to cancel this request?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Yes, cancel it'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('formCancelStatus').submit();
                }
            });
        });
    })();
</script>
