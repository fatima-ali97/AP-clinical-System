@using AP_clinical_system.Models.Entities
@using AP_clinical_system.Models.Enums
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Receptionist Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var appointments = ViewBag.Appointments as List<appointment> ?? new();
    var patientUserMap = ViewBag.PatientUserMap as Dictionary<Guid, system_user> ?? new();
    var doctorUserMap = ViewBag.DoctorUserMap as Dictionary<Guid, system_user> ?? new();

    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var todayAppointments = appointments.ToList();

    static string StatusBadge(int? status) => status switch
    {
        (int)appointment_status.completed => "badge-success",
        (int)appointment_status.cancelled => "badge-danger",
        (int)appointment_status.no_show => "badge-danger",
        (int)appointment_status.in_progress => "badge-warning",
        (int)appointment_status.confirmed => "badge-info",
        (int)appointment_status.checked_in => "badge-info",
        _ => "badge-info"
    };

    static string StatusLabel(int? status) => status switch
    {
        (int)appointment_status.completed => "Completed",
        (int)appointment_status.cancelled => "Cancelled",
        (int)appointment_status.no_show => "No Show",
        (int)appointment_status.in_progress => "In Progress",
        (int)appointment_status.confirmed => "Confirmed",
        (int)appointment_status.checked_in => "Checked In",
        (int)appointment_status.requested => "Requested",
        _ => "Unknown"
    };

    static string SlotToTime(int? slot)
    {
        if (slot == null) return "TBD";

        int minutes = (slot.Value - 1000) * 30;

        if (minutes < 0) return $"Invalid ({slot})";

        int hour = 8 + (minutes / 60);
        int min = minutes % 60;

        if (hour >= 24) return $"Invalid ({slot})";

        return new DateTime(2000, 1, 1, hour, min, 0).ToString("hh:mm tt");
    }
}

@section Styles
{
    <link href="~/css/app/app.css" rel="stylesheet" />
    <link href="~/css/app/Appointment-modalView.css" rel="stylesheet" />
    <link href="~/css/app/Prescription-modalView.css" rel="stylesheet" />
    <link href="~/css/components/Forms.css" rel="stylesheet" />
    <link href="~/css/app/ProfileCard.css" rel="stylesheet" />
}

@section scripts
{
    <script src="~/js/components/custom-dataTable.js"></script>
    <script src="~/js/components/ProfileCard.js"></script>
}

<!-- ── STAT CARDS ── -->
<div class="stat-grid patient">

    <div class="card">
        <div class="card-body" style="padding: 0;">
            <a href="#" class="hpd hpd-basic">
                <h4 class="hpd-title">Welcome, Receptionist</h4>
                <p class="hpd-desc">Manage today's schedule and handle patient check-ins.</p>
                <span href="/Patient/Index" class="hpd-btn">View Patient Flow</span>
            </a>
        </div>
    </div>

    <!-- Total number of Appointments today -->
    <div class="card d-flex align-items-center justify-content-center flex-column text-center" style="padding: 20px;">
        <h5 class="text-muted mb-2">Appointments Today</h5>
        <h1 class="display-4 text-primary m-0" style="font-weight: bold;">@todayAppointments.Count</h1>
    </div>
</div>

<!-- ── CALENDAR + REAL-TIME GRAPH── -->
<div class="bottom-grid patient">
    <div class="card" style="grid-column: span 3;">
        <div class="card-header">
            <h5 class="card-title">Recent Notifications</h5>
        </div>
        <div class="card-body" style="min-height:220px;">
            <div class="container my-5">
                <div class="row">
                    <div class="col-md-6 offset-md-3">
                        <ul class="timeline-3">
                            <li>
                                <a href="#!">System Update</a>
                                <a href="#!" class="float-end">Today</a>
                                <p class="mt-2">Welcome to the new Receptionist dashboard.</p>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h5 class="card-title mb-0">Appointments Today</h5>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary">
                @todayAppointments.Count appointment@(todayAppointments.Count == 1 ? "" : "s")
            </span>
            <button type="button" class="btn btn-sm btn-outline-success" id="openAddApptBtn" title="Add new appointment">
                <i class="bi bi-plus-lg"></i> Add Appointment
            </button>
        </div>
    </div>
    <div style="overflow-x: auto;">
        <table class="data-table table table-hover align-middle mb-0 ap-datatable" style="width:100%">
            <thead>
                <tr>
                    <th>Appointment No.</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th class="d-none-xs">Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th class="d-none-sm text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in todayAppointments)
                {
                    system_user? patientUser = null;
                    if (appt.patient_ref.HasValue)
                        patientUserMap.TryGetValue(appt.patient_ref.Value, out patientUser);

                    system_user? doctorUser = null;
                    if (appt.doctor_ref.HasValue)
                        doctorUserMap.TryGetValue(appt.doctor_ref.Value, out doctorUser);

                    string patientName = patientUser != null ? $"{patientUser.first_name} {patientUser.last_name}".Trim() : "—";
                    string doctorName = doctorUser != null ? $"Dr. {doctorUser.first_name} {doctorUser.last_name}".Trim() : "—";
                    string dateDisplay = appt.date?.ToString("dd MMM yyyy") ?? "—";

                    <tr>
                        <td>@(appt.appointment_no ?? "—")</td>
                        <td>@patientName</td>
                        <td>@doctorName</td>
                        <td class="d-none-xs">@dateDisplay</td>
                        <td>@SlotToTime(appt.appointment_time_slot)</td>
                        <td>
                            <span class="badge @StatusBadge(appt.appointment_status)">
                                @StatusLabel(appt.appointment_status)
                            </span>
                        </td>
                        <td class="d-none-sm text-center">
                            @{
                                var doctorUserId = appt.doctor_ref.HasValue && doctorUserMap.TryGetValue(appt.doctor_ref.Value, out var du) ? du?.Id.ToString() : "";
                            }
                            @if (appt.appointment_status == (int)appointment_status.requested)
                            {
                                <button type="button" class="btn btn-sm btn-outline-success idx-action-btn"
                                        data-appt-id="@appt.id" data-action-type="confirm">
                                    Confirm
                                </button>
                            }
                            else if (appt.appointment_status == (int)appointment_status.confirmed)
                            {
                                <button type="button" class="btn btn-sm btn-outline-info idx-action-btn"
                                        data-appt-id="@appt.id" data-action-type="checkin">
                                    Check In
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger idx-action-btn"
                                        data-appt-id="@appt.id" data-action-type="noshow">
                                    No Show
                                </button>
                            }
                            else if (appt.appointment_status == (int)appointment_status.checked_in)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger idx-action-btn"
                                        data-appt-id="@appt.id" data-action-type="cancel">
                                    Cancel
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary view-appt-btn"
                                    data-appt-id="@appt.id">
                                <i class="bi bi-eye"></i> View
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning reschedule-trigger-btn"
                                    data-appt-id="@appt.id"
                                    data-doctor-user-id="@doctorUserId">
                                <i class="bi bi-calendar-event"></i> Reschedule
                            </button>
                        </td>
                    </tr>
                }
                @if (!todayAppointments.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No appointments found for today.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.AntiForgeryToken()
@await Html.PartialAsync("~/Views/Patient/_SingleAppointmentView.cshtml")
@await Html.PartialAsync("~/Views/Receptionist/_AddAppointmentForm.cshtml")
@await Html.PartialAsync("~/Views/Receptionist/_RescheduleAppointmentForm.cshtml")

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Wire up Add Appointment button
    document.getElementById('openAddApptBtn')?.addEventListener('click', function () {
        document.getElementById('apptModalBackdrop')?.classList.add('open');
        document.body.style.overflow = 'hidden';
    });

    // Wire up View Appointment buttons
    document.addEventListener('click', function (e) {
        const viewBtn = e.target.closest('.view-appt-btn');
        if (viewBtn) {
            const apptId = viewBtn.dataset.apptId;
            const viewBackdrop = document.getElementById('apptViewBackdrop');
            if (viewBackdrop) {
                viewBackdrop.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }
    });

    // AJAX action handler for Index table buttons
    const idxActionMap = {
        confirm: { url: '/Receptionist/ConfirmAppointment', q: 'Confirm this appointment?', icon: 'question', color: '#10b981' },
        checkin: { url: '/Receptionist/CheckInAppointment', q: 'Mark as Checked In?', icon: 'info', color: '#06b6d4' },
        noshow:  { url: '/Receptionist/NoShowAppointment',  q: 'Mark as No Show?', icon: 'warning', color: '#6b7280' },
        cancel:  { url: '/Receptionist/CancelAppointment',  q: 'Cancel this appointment?', icon: 'warning', color: '#ef4444' }
    };

    document.addEventListener('click', async function (e) {
        const btn = e.target.closest('.idx-action-btn');
        if (!btn) return;
        const cfg = idxActionMap[btn.dataset.actionType];
        if (!cfg) return;

        const { isConfirmed } = await Swal.fire({
            icon: cfg.icon, title: cfg.q,
            showCancelButton: true,
            confirmButtonText: 'Proceed', confirmButtonColor: cfg.color,
            cancelButtonColor: '#6b7280'
        });
        if (!isConfirmed) return;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch(cfg.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `appointment_id=${encodeURIComponent(btn.dataset.apptId)}`
            });
            const data = await res.json();
            if (res.ok && data.success) {
                await Swal.fire({ icon: 'success', title: 'Updated!', confirmButtonColor: '#38789e' });
                location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Failed', text: data.error || 'Action could not be completed.', confirmButtonColor: '#38789e' });
            }
        } catch {
            Swal.fire({ icon: 'error', title: 'Error', text: 'Connection error. Please retry.', confirmButtonColor: '#38789e' });
        }
    });
</script>

<script>
    const events = [
        { date: '2026-04-05', name: 'General Visit', time: '10:00 AM' },
        { date: '2026-04-05', name: 'General Visit', time: '04:10 PM' },
        { date: '2026-04-05', name: 'General Visit', time: '06:30 PM' },
        { date: '2026-04-12', name: 'Follow-up Visit', time: '09:00 AM' },
        { date: '2026-04-18', name: 'Lab Results Review', time: '02:30 PM' },
        { date: '2026-04-24', name: 'Specialist Consult', time: '11:00 AM' },
    ];

    let current = new Date(2026, 3, 1);
    let selectedDate = '2026-04-16';

    function formatKey(d) {
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    function changeMonth(dir) {
        current = new Date(current.getFullYear(), current.getMonth() + dir, 1);
        render();
    }

    function selectDay(key) {
        selectedDate = key;
        render();
    }

    function render() {
        const year = current.getFullYear();
        const month = current.getMonth();
        const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        document.getElementById('month-title').textContent = months[month] + ' ' + year;

        const grid = document.getElementById('days-grid');
        grid.innerHTML = '';

        const today = formatKey(new Date());
        const firstDay = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();
        const prevDays = new Date(year, month, 0).getDate();

        const eventMap = {};
        events.forEach(ev => {
            if (!eventMap[ev.date]) eventMap[ev.date] = [];
            eventMap[ev.date].push(ev);
        });

        for (let i = 0; i < firstDay; i++) {
            const d = prevDays - firstDay + 1 + i;
            const cell = document.createElement('div');
            cell.className = 'day-cell other';
            cell.innerHTML = `<span class="day-num">${d}</span>`;
            grid.appendChild(cell);
        }

        for (let d = 1; d <= daysInMonth; d++) {
            const key = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
            const cell = document.createElement('div');
            let cls = 'day-cell';
            if (key === today) cls += ' today';
            else if (key === selectedDate) cls += ' selected';
            cell.className = cls;
            const dots = eventMap[key] ? `<div class="dot-row">${eventMap[key].slice(0, 3).map((_, i) => `<div class="dot ${['blue', 'green', 'purple'][i % 3]}"></div>`).join('')}</div>` : '';
            cell.innerHTML = `<span class="day-num">${d}</span>${dots}`;
            cell.onclick = () => selectDay(key);
            grid.appendChild(cell);
        }

        const totalCells = firstDay + daysInMonth;
        const remaining = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
        for (let i = 1; i <= remaining; i++) {
            const cell = document.createElement('div');
            cell.className = 'day-cell other';
            cell.innerHTML = `<span class="day-num">${i}</span>`;
            grid.appendChild(cell);
        }

        const dayEvents = events.filter(ev => ev.date === selectedDate);
        const list = document.getElementById('events-list');
        const label = document.getElementById('events-label');

        if (selectedDate) {
            const [y, m, dd] = selectedDate.split('-');
            const dateObj = new Date(+y, +m - 1, +dd);
            const opts = { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' };
            label.textContent = dayEvents.length ? `Appointments — ${dateObj.toLocaleDateString('en-GB', opts)}` : 'No appointments';
        }

        list.innerHTML = '';
        if (!dayEvents.length) {
            list.innerHTML = '<div style="color: var(--color-text-tertiary); font-size: 14px; text-align:center; padding: 16px;">No appointments on this day</div>';
            return;
        }

        dayEvents.sort((a, b) => a.time.localeCompare(b.time));
        dayEvents.forEach((ev, idx) => {
            const card = document.createElement('div');
            card.className = 'event-card' + (idx === 0 ? ' highlighted' : '');
            card.innerHTML = `
                                                  <div class="event-name">${ev.name}</div>
                                                  <div class="event-time">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                                    ${['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date(...selectedDate.split('-').map((v, i) => i === 1 ? +v - 1 : +v)).getDay()]}, ${selectedDate.split('-')[2]} ${['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][+selectedDate.split('-')[1] - 1]} ${selectedDate.split('-')[0]}, ${ev.time}
                                                  </div>
                                                `;
            list.appendChild(card);
        });
    }

    render();
</script>