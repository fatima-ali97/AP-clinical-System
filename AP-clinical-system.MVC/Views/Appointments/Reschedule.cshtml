@using AP_clinical_system.Models.Entities
@using AP_clinical_system.Models.Enums

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reschedule Appointment";
    ViewData["ActivePage"] = "My Appointments";
    ViewBag.DevRole = "Patient";

    var appt = ViewBag.Appointment as appointment;
    var doctorUser = ViewBag.DoctorUser as AP_clinical_system.Models.Entities.system_user;
    var doctorInfo = ViewBag.DoctorInfo as doctor_information;
    var specialization = ViewBag.Specialization as doctor_specialization;

    string doctorName = doctorUser != null
        ? $"Dr. {doctorUser.first_name} {doctorUser.last_name}".Trim()
        : "—";

    static string SlotToTime(int? slot)
    {
        if (slot == null) return "TBD";
        int minutes = (slot.Value - 1000) * 30;
        int hour = 8 + minutes / 60;
        int min = minutes % 60;
        return new DateTime(2000, 1, 1, hour, min, 0).ToString("hh:mm tt");
    }
}

@section Styles {
    <link href="~/css/components/Forms.css" rel="stylesheet" />
}

<div class="main-page-header">
    <h1>Reschedule Appointment</h1>
    <button class="btn btn-outline-secondary btn-sm"><a href="/Patient/Appointments">Back to Appointments</a> </button>
</div>

<div class="container" style="width: 100%">

    <p style="color:red;font-size:12px">
        DoctorInfo.id: @doctorInfo?.id <br />
        DoctorInfo.system_user_ref: @doctorInfo?.system_user_ref <br />
        DoctorUser.Id: @doctorUser?.Id <br />
        DoctorUserRef ViewBag: @ViewBag.DoctorUserRef
    </p>
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title mb-0">Current Appointment Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-6">
                    <div class="profile-field-label">Appointment No.</div>
                    <div class="profile-field-value fw-semibold">@appt?.appointment_no</div>
                </div>
                <div class="col-6">
                    <div class="profile-field-label">Doctor</div>
                    <div class="profile-field-value">@doctorName</div>
                </div>
                <div class="col-6">
                    <div class="profile-field-label">Specialization</div>
                    <div class="profile-field-value">@(specialization?.specialization_name ?? "—")</div>
                </div>
                <div class="col-6">
                    <div class="profile-field-label">Current Date & Time</div>
                    <div class="profile-field-value">
                        @(appt?.date?.ToString("dd MMM yyyy") ?? "—")
                        &nbsp;·&nbsp;
                        @SlotToTime(appt?.appointment_time_slot)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Select New Date & Time</h5>
        </div>
        <div class="card-body">
            <div id="reschedule-feedback" class="alert d-none mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Available Dates</label>
                <select id="dateSelect" class="form-select" disabled>
                    <option value="">Loading available dates…</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Available Time Slots</label>
                <div id="timeSlotGrid" class="d-flex flex-wrap gap-2">
                    <span class="text-muted small">Select a date first</span>
                </div>
                <input type="hidden" id="selectedSlot" value="" />
            </div>

            <div class="d-flex gap-2">
                <button id="confirmReschedule" class="btn btn-primary" disabled>
                    Confirm Reschedule
                </button>
                <a href="/Patient/Appointments" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script>
        (function () {
            const appointmentId = '@Html.Raw(appt?.id.ToString())';
            const doctorUserId = '@Html.Raw(doctorInfo?.system_user_ref?.ToString() ?? "")';

            const dateSelect = document.getElementById('dateSelect');
            const timeSlotGrid = document.getElementById('timeSlotGrid');
            const selectedSlotInput = document.getElementById('selectedSlot');
            const confirmBtn = document.getElementById('confirmReschedule');
            const feedback = document.getElementById('reschedule-feedback');

            function slotToTime(slot) {
                const minutes = (slot - 1000) * 30;
                const hour = 8 + Math.floor(minutes / 60);
                const min = minutes % 60;
                const suffix = hour >= 12 ? 'PM' : 'AM';
                const h12 = hour > 12 ? hour - 12 : hour === 0 ? 12 : hour;
                return `${String(h12).padStart(2, '0')}:${String(min).padStart(2, '0')} ${suffix}`;
            }

            let availabilityData = [];

            async function loadAvailability() {
                if (!doctorUserId) {
                    showFeedback('danger', 'Doctor ID is missing.');
                    dateSelect.innerHTML = '<option value="">Unavailable</option>';
                    return;
                }
                try {
                    const res = await fetch(`/Appointments/GetAvailableDatesAndTimesByDoctorIDGet?doctorID=${doctorUserId}`);
                    if (!res.ok) {
                        const errText = await res.text();
                        showFeedback('danger', 'Could not load availability: ' + errText);
                        dateSelect.innerHTML = '<option value="">No dates available</option>';
                        dateSelect.disabled = true;
                        return;
                    }
                    availabilityData = await res.json();
                    if (availabilityData.length === 0) {
                        showFeedback('warning', 'No available dates found for this doctor in the next 30 days.');
                        dateSelect.innerHTML = '<option value="">No dates available</option>';
                        return;
                    }
                    dateSelect.innerHTML = '<option value="">— Select a date —</option>';
                    availabilityData.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.date;
                        const label = new Date(d.date + 'T00:00:00').toLocaleDateString('en-GB',
                            { weekday: 'short', day: '2-digit', month: 'short', year: 'numeric' });
                        opt.textContent = label;
                        dateSelect.appendChild(opt);
                    });
                    dateSelect.disabled = false;
                } catch (e) {
                    showFeedback('danger', 'Network error: ' + e.message);
                    dateSelect.innerHTML = '<option value="">Error loading dates</option>';
                }
            }

            dateSelect.addEventListener('change', () => {
                const chosen = availabilityData.find(d => d.date === dateSelect.value);
                selectedSlotInput.value = '';
                confirmBtn.disabled = true;
                if (!chosen) {
                    timeSlotGrid.innerHTML = '<span class="text-muted small">Select a date first</span>';
                    return;
                }
                timeSlotGrid.innerHTML = '';
                chosen.availableTimeSlots.forEach(slot => {
                    const chip = document.createElement('button');
                    chip.type = 'button';
                    chip.className = 'btn btn-outline-secondary btn-sm time-chip';
                    chip.dataset.slot = slot;
                    chip.textContent = slotToTime(slot);
                    chip.addEventListener('click', () => {
                        document.querySelectorAll('.time-chip').forEach(c => {
                            c.classList.remove('active', 'btn-primary');
                            c.classList.add('btn-outline-secondary');
                        });
                        chip.classList.add('active', 'btn-primary');
                        chip.classList.remove('btn-outline-secondary');
                        selectedSlotInput.value = slot;
                        confirmBtn.disabled = false;
                    });
                    timeSlotGrid.appendChild(chip);
                });
            });

            confirmBtn.addEventListener('click', async () => {
                const newDate = dateSelect.value;
                const newSlot = selectedSlotInput.value;
                if (!newDate || !newSlot) return;

                confirmBtn.disabled = true;
                confirmBtn.textContent = 'Saving…';

                // Read token from the @Html.AntiForgeryToken() input rendered in the page body
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

                const body = new URLSearchParams({
                    appointment_id: appointmentId,
                    new_date: newDate,
                    new_time_slot: newSlot,
                    __RequestVerificationToken: token
                });

                try {
                    const res = await fetch('/Appointments/SaveReschedule', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: body.toString()
                    });
                    const data = await res.json();
                    if (data.success) {
                        showFeedback('success', 'Appointment rescheduled successfully! Redirecting…');
                        setTimeout(() => window.location.href = '/Patient/Appointments', 1500);
                    } else {
                        showFeedback('danger', data.error ?? 'Something went wrong.');
                        confirmBtn.disabled = false;
                        confirmBtn.textContent = 'Confirm Reschedule';
                    }
                } catch (e) {
                    showFeedback('danger', 'Network error. Please try again.');
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = 'Confirm Reschedule';
                }
            });

            function showFeedback(type, msg) {
                feedback.className = 'alert alert-' + type;
                feedback.textContent = msg;
                feedback.classList.remove('d-none');
            }

            loadAvailability();
        })();
    </script>
}