@using AP_clinical_system.Models.Entities
@using AP_clinical_system.Models.Enums



<div class="singleAppt-backdrop" id="singleApptModalBackdrop">
    <div class="singleAppt-modal" id="singleApptModal" role="dialog" aria-modal="true">
        <div class="singleAppt-modal-header">
            <h5>Appointment Info</h5>
            <button type="button" class="appt-close-btn" id="singleApptCloseBtn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="singleAppt-modal-body">
            <p id="singleApptContent">Appointment info goes here.</p>
        </div>
    </div>
</div>

<script>
    (function () {
        function openModal() {
            document.getElementById('singleApptModalBackdrop').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeModal() {
            document.getElementById('singleApptModalBackdrop').classList.remove('open');
            document.body.style.overflow = '';
        }

       
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-action="view-appointment"]');
            if (btn) {
                e.preventDefault();
                openModal();
            }
        });

        document.getElementById('singleApptCloseBtn').addEventListener('click', closeModal);

        document.getElementById('singleApptModalBackdrop').addEventListener('click', function (e) {
            if (e.target === this) closeModal();
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeModal();
        });
    })();
</script>