@model AP_clinical_system.Models.LookupRequest

@{
    ViewData["Title"] = "Appointment Lookup";
    Layout = "_Layout";
}

<h2 class="mb-2">Appointment Lookup</h2>
<p class="text-muted mb-4">
    Enter your CPR or Record No. below
</p>

<div class="container">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-10">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-4" role="alert">
                    <div asp-validation-summary="All" class="small mb-0"></div>
                </div>
            }

            <form asp-action="Lookup" method="post">

                <div class="mb-4">
                    <label asp-for="Cpr" class="form-label fw-semibold">
                        CPR Number
                    </label>

                    <input asp-for="Cpr" class="form-control form-control-lg rounded-3" />
                </div>

                <div class="mb-4">
                    <label asp-for="RecordNo" class="form-label fw-semibold">
                        Record Number
                    </label>

                    <input asp-for="RecordNo" class="form-control form-control-lg rounded-3" />
                </div>

                <button type="submit"
                        class="btn btn-primary btn-lg w-100 rounded-3 shadow-sm fw-bold">
                    Lookup Records
                </button>

            </form>

            @if (ViewBag.LookupResultJson != null)
            {
             
                <script>
                    document.addEventListener("DOMContentLoaded", function () {

                        var rawText =
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.LookupResultJson));

                        try {

                            var formattedJson =
                                JSON.stringify(JSON.parse(rawText), null, 2);

                            document.getElementById("rawJsonCode")
                                .textContent = formattedJson;

                        }
                        catch (e) {

                            document.getElementById("rawJsonCode")
                                .textContent = rawText;
                        }

                    });
                </script>
            }

        </div>

    </div>

</div>