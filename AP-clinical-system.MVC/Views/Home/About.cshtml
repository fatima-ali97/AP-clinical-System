@{
    ViewData["Title"] = "About Us";
    Layout = "_Layout";
}
<section class="container-fluid rounded about-advancedhealth-hero">
    <div class="about-advancedhealth-hero--intro">
        <h2>Welcome to AdvancedHealth</h2>
        <p>AdvancedHealth is redefining the standard of private healthcare in the Kingdom. By combining cutting-edge medical infrastructure with multi-specialty clinics managed by renowned Senior Consultants, we deliver a highly personalized patient experience.</p>
    </div>
    <div class="about-advancedhealth-hero--care-callout">
        <div class="care-callout-box">
            <div class="care-callout-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>

            <p>
                Our 24-Hour AdvancedHealth Urgent Care Clinic provides reliable,
                seamless, and immediate access to world-class medical services
                whenever you or your family need them most.
            </p>
        </div>
    </div>
</section>

<section class="container my-5">
    <div class="row align-items-center mt-5">
        <div class="col-12 text-center mb-4">
            <h1 class="about-main-title">
                AdvancedHealth is a trusted provider of <br />
                <span>advanced healthcare</span> in Bahrain.
            </h1>
        </div>
        <div class="col-md-6">
            <p>
                AdvancedHealth is a leading and trusted healthcare provider in the Kingdom
                of Bahrain, delivering integrated and patient-centered medical services
                through advanced facilities, modern technology, and experienced healthcare
                professionals. Our commitment to clinical excellence ensures every patient
                receives high-quality care within a comfortable and compassionate environment.
            </p>
        </div>
        <div class="col-md-6">
            <p>
                With a focus on innovation and personalized treatment, AdvancedHealth offers
                comprehensive healthcare solutions across multiple specialties, supported by
                state-of-the-art diagnostic services, modern operating facilities, and
                24-hour urgent care designed to meet the evolving healthcare needs of
                individuals and families across the Kingdom.
            </p>
        </div>
    </div>
    <div class="rounded overflow-hidden img-hover-zoom" style="height:250px">
        <img src="~/assets/surgeons-inside-an-operating-room.jpg" alt="Reception staff reviewing documents at a medical center" class="img-fluid h-100 w-100 object-fit-cover" style="object-position: right;" />
    </div>
</section>
<section class="container my-5">
    <div class="row align-items-center mt-5">
        <div id="mission-vision" class="row">

            <div class="col-md-6">
                <div class="card-white-rounded mission-vision--card h-100">
                    <h3>Below is Our Mission</h3>
                    <p>
                        " AdvancedHealth is committed to delivering exceptional, patient-centered
                        healthcare through medical excellence, innovation, and compassionate care. "
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card-white-rounded mission-vision--card h-100">
                    <h3>Below is Our Vision</h3>
                    <p>
                        " Our vision is to become Bahrain’s preferred private healthcare provider,
                        recognized for quality, trust, and excellence in patient care. "
                    </p>
                </div>
            </div>

        </div>
    </div>

    <div class="col-12 mt-5">
        <div class="text-center mb-4">
            <h2 class="about-main-title">Our Values</h2>
            <p class="fs-5">We will remain firmly committed to our “We Care” values of:</p>
        </div>

        <div class="our-values-container">

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <span class="value-text">Wellbeing</span>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <span class="value-text">Ethical</span>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-heart-fill"></i>
                    </div>
                    <span class="value-text">Compassion</span>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <span class="value-text">Accountability</span>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                    <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="value-text">Respect</span>
                </div>

                <div class="value-item">
                    <div class="value-icon">
                        <i class="bi bi-gem"></i>
                    </div>
                    <span class="value-text">Excellence</span>
                </div>

            </div>
    </div>
</section>
