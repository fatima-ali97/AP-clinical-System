@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Manager Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<h1 class="page-heading">Clinical Manager's Dashboard</h1>

<!-- ── STAT CARDS ── -->
<div class="stat-grid admin">

    <div class="card stat-card">
        <div class="card-body" style="background: #7a97b8;">
            <span class="tri-bl"></span>
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Requested</div>
                    <div class="stat-value" id="requested">-</div>
                </div>
                <div class="stat-icon" style="background: #c8d9eb;">
                    <i class="fa-solid fa-clock" style="color: #3a5f8a;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #5e9fa8;">
            <span class="tri-bl"></span>
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Confirmed</div>
                    <div class="stat-value" id="confirmed">-</div>
                </div>
                <div class="stat-icon" style="background-color: #b0d8de;">
                    <i class="fa-solid fa-circle-check" style="color: #205a64;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #6a8f6a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Checked In</div>
                    <div class="stat-value" id="checked_in">-</div>
                </div>
                <div class="stat-icon" style="background-color: #b8d4b8;">
                    <i class="fa-solid fa-right-to-bracket" style="color: #2a5a2a;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #c4975a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">In Progress</div>
                    <div class="stat-value" id="in_progress">-</div>
                </div>
                <div class="stat-icon" style="background-color: #e8d0a8;">
                    <i class="fa-solid fa-spinner" style="color: #7a5020;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #9080b8;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Completed</div>
                    <div class="stat-value" id="completed">-</div>
                </div>
                <div class="stat-icon" style="background-color: #ccc0e0;">
                    <i class="fa-solid fa-calendar-check" style="color: #4a3480;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #b85a5a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Cancelled</div>
                    <div class="stat-value" id="cancelled">-</div>
                </div>
                <div class="stat-icon" style="background-color: #e0a8a8;">
                    <i class="fa-solid fa-circle-xmark" style="color: #7a1a1a;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body" style="background: #8a8a8a;">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">No Show</div>
                    <div class="stat-value" id="no_show">-</div>
                </div>
                <div class="stat-icon" style="background-color: #c8c8c8;">
                    <i class="fa-solid fa-user-slash" style="color: #3a3a3a;"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/hubs/appointmentsWatcher")
    .withAutomaticReconnect()
    .build();

    connection.on("UpdateStatuses", (data) => {
    document.getElementById("requested").innerText = data.requested;
    document.getElementById("confirmed").innerText = data.confirmed;
    document.getElementById("checked_in").innerText = data.checked_in;
    document.getElementById("in_progress").innerText = data.in_progress;
    document.getElementById("completed").innerText = data.completed;
    document.getElementById("cancelled").innerText = data.cancelled;
    document.getElementById("no_show").innerText = data.no_show;
    });

    connection.start()
    .then(() => console.log("SignalR connected"))
    .catch(err => console.error("SignalR error:", err));
</script>

<!-- ── CHARTS ROW ── -->
<div class="bottom-grid">

    <!-- Bar chart: Appointments by Day of Week -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Appointments by Day of Week</h5>
            <span class="card-subtitle">Last 90 days</span>
        </div>
        <div class="card-body" style="min-height: 260px; display:flex; align-items:center; justify-content:center;">
            <canvas id="dowChart" style="width:100%; max-height:240px;"></canvas>
        </div>
    </div>

    <!-- Line chart: 30-day appointment trend -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">30-Day Appointment Trend</h5>
            <span class="card-subtitle">Total · Completed · Cancelled</span>
        </div>
        <div class="card-body" style="min-height: 260px; display:flex; align-items:center; justify-content:center;">
            <canvas id="trendChart" style="width:100%; max-height:240px;"></canvas>
        </div>
    </div>

</div>

<!-- ── TODAY'S APPOINTMENTS TABLE ── -->
<div class="card">
    <div class="card-header">
        <h5 class="card-title">Today's Appointments</h5>
    </div>
    <div style="overflow-x: auto;">
        <table class="data-table" id="todayTable">
            <thead>
                <tr>
                    <th>Appt #</th>
                    <th>Time</th>
                    <th>Patient</th>
                    <th class="d-none-xs">Doctor</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="todayTableBody">
                <tr>
                    <td colspan="5" style="text-align:center; color:#9ca3af; padding:24px;">
                        Loading…
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
    .card-subtitle {
    font-size: 12px;
    color: var(--color-slate-400, #94a3b8);
    margin-left: 8px;
    font-weight: 400;
    }

    .status-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    }

    .status-requested {
    background: #e0e7ff;
    color: #3730a3;
    }

    .status-confirmed {
    background: #d1fae5;
    color: #065f46;
    }

    .status-checked_in {
    background: #bfdbfe;
    color: #1e40af;
    }

    .status-in_progress {
    background: #fef3c7;
    color: #92400e;
    }

    .status-completed {
    background: #d1fae5;
    color: #065f46;
    }

    .status-cancelled {
    background: #fee2e2;
    color: #991b1b;
    }

    .status-no_show {
    background: #f3f4f6;
    color: #374151;
    }

    .status-unknown {
    background: #f3f4f6;
    color: #6b7280;
    }
</style>

<script>
    // ── Status label → CSS class mapping
    const statusClassMap = {
    "Requested": "status-requested",
    "Confirmed": "status-confirmed",
    "Checked In": "status-checked_in",
    "In Progress": "status-in_progress",
    "Completed": "status-completed",
    "Cancelled": "status-cancelled",
    "No Show": "status-no_show",
    };

    // ── Chart.js shared defaults
    Chart.defaults.font.family = "'Urbanist', 'Segoe UI', sans-serif";
    Chart.defaults.color = "#64748b";

    // ── 1. Appointments by Day of Week (Bar)
    async function loadDowChart() {
    try {
    const res = await fetch('/Manager/GetAppointmentsByDayOfWeek');
    if (!res.ok) return;
    const data = await res.json();

    const labels = data.map(d => d.day);
    const counts = data.map(d => d.count);
    const maxCount = Math.max(...counts, 1);

    // Gradient fill per bar using brand color
    const ctx = document.getElementById('dowChart').getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 240);
    grad.addColorStop(0, 'rgba(56,120,158,0.85)');
    grad.addColorStop(1, 'rgba(57,155,158,0.55)');

    new Chart(ctx, {
    type: 'bar',
    data: {
    labels,
    datasets: [{
    label: 'Appointments',
    data: counts,
    backgroundColor: grad,
    borderRadius: 8,
    borderSkipped: false,
    borderWidth: 0,
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: true,
    plugins: {
    legend: { display: false },
    tooltip: {
    backgroundColor: '#1e293b',
    padding: 10,
    cornerRadius: 8,
    callbacks: {
    label: ctx => ` ${ctx.parsed.y} appointments`
    }
    }
    },
    scales: {
    x: {
    grid: { display: false },
    border: { display: false },
    ticks: { font: { size: 13, weight: '600' } }
    },
    y: {
    grid: { color: 'rgba(0,0,0,0.05)' },
    border: { display: false, dash: [4, 4] },
    ticks: {
    stepSize: Math.ceil(maxCount / 5) || 1,
    font: { size: 12 }
    },
    beginAtZero: true
    }
    }
    }
    });
    } catch (e) {
    console.error('DOW chart error:', e);
    }
    }

    // ── 2. 30-day Trend (Line)
    async function loadTrendChart() {
    try {
    const res = await fetch('/Manager/GetAppointmentTrend?days=30');
    if (!res.ok) return;
    const data = await res.json();

    // Show every 5th label to avoid crowding
    const labels = data.map((d, i) => i % 5 === 0 ? d.date : '');

    const ctx = document.getElementById('trendChart').getContext('2d');

    const totalGrad = ctx.createLinearGradient(0, 0, 0, 220);
    totalGrad.addColorStop(0, 'rgba(56,120,158,0.18)');
    totalGrad.addColorStop(1, 'rgba(56,120,158,0)');

    new Chart(ctx, {
    type: 'line',
    data: {
    labels,
    datasets: [
    {
    label: 'Total',
    data: data.map(d => d.total),
    borderColor: '#38789e',
    backgroundColor: totalGrad,
    borderWidth: 2.5,
    pointRadius: 0,
    pointHoverRadius: 5,
    tension: 0.4,
    fill: true,
    },
    {
    label: 'Completed',
    data: data.map(d => d.completed),
    borderColor: '#3db670',
    backgroundColor: 'transparent',
    borderWidth: 2,
    pointRadius: 0,
    pointHoverRadius: 5,
    tension: 0.4,
    borderDash: [],
    },
    {
    label: 'Cancelled',
    data: data.map(d => d.cancelled),
    borderColor: '#e54848',
    backgroundColor: 'transparent',
    borderWidth: 2,
    pointRadius: 0,
    pointHoverRadius: 5,
    tension: 0.4,
    borderDash: [5, 4],
    }
    ]
    },
    options: {
    responsive: true,
    maintainAspectRatio: true,
    interaction: { mode: 'index', intersect: false },
    plugins: {
    legend: {
    position: 'bottom',
    labels: {
    boxWidth: 12,
    boxHeight: 12,
    borderRadius: 3,
    useBorderRadius: true,
    padding: 16,
    font: { size: 12 }
    }
    },
    tooltip: {
    backgroundColor: '#1e293b',
    padding: 10,
    cornerRadius: 8,
    }
    },
    scales: {
    x: {
    grid: { display: false },
    border: { display: false },
    ticks: { font: { size: 11 } }
    },
    y: {
    grid: { color: 'rgba(0,0,0,0.05)' },
    border: { display: false },
    ticks: { font: { size: 12 } },
    beginAtZero: true
    }
    }
    }
    });
    } catch (e) {
    console.error('Trend chart error:', e);
    }
    }

    // ── 3. Today's Appointments Table
    async function loadTodaysTable() {
    const tbody = document.getElementById('todayTableBody');
    try {
    const res = await fetch('/Manager/GetTodaysAppointments');
    if (!res.ok) throw new Error(res.statusText);
    const rows = await res.json();

    if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#9ca3af; padding:24px;">No appointments today</td></tr>`;
    return;
    }

    tbody.innerHTML = rows.map(r => {
    const cls = statusClassMap[r.status] ?? 'status-unknown';
    return `
    <tr>
    <td><code style="font-size:12px;">${r.appointment_no ?? '—'}</code></td>
    <td>${r.time}</td>
    <td>${r.patient}</td>
    <td class="d-none-xs">${r.doctor}</td>
    <td><span class="status-badge ${cls}">${r.status}</span></td>
    </tr>`;
    }).join('');
    } catch (e) {
    tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:#e54848; padding:24px;">Failed to load appointments</td></tr>`;
    console.error('Today table error:', e);
    }
    }

    // ── Init all
    loadDowChart();
    loadTrendChart();
    loadTodaysTable();
</script>
