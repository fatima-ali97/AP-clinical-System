@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

<h1 class="page-heading"><strong>Analytics</strong> Dashboard</h1>

<!-- ── STAT CARDS ── -->
<div class="stat-grid">

    <div class="card">
        <div class="card-body">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Sales</div>
                    <div class="stat-value">2.382</div>
                    <div class="stat-footer">
                        <span class="text-danger">-3.65%</span>
                        <span class="text-muted"> Since last week</span>
                    </div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="3" width="15" height="13" rx="1" />
                        <path d="M16 8l5 2v4l-5 2" />
                        <circle cx="5.5" cy="18.5" r="2.5" />
                        <circle cx="18.5" cy="18.5" r="2.5" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Visitors</div>
                    <div class="stat-value">14.212</div>
                    <div class="stat-footer">
                        <span class="text-success">5.25%</span>
                        <span class="text-muted"> Since last week</span>
                    </div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Earnings</div>
                    <div class="stat-value">$21.300</div>
                    <div class="stat-footer">
                        <span class="text-success">6.65%</span>
                        <span class="text-muted"> Since last week</span>
                    </div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="stat-card-inner">
                <div>
                    <div class="stat-label">Orders</div>
                    <div class="stat-value">64</div>
                    <div class="stat-footer">
                        <span class="text-danger">-2.25%</span>
                        <span class="text-muted"> Since last week</span>
                    </div>
                </div>
                <div class="stat-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ── CALENDAR + REAL-TIME ── -->
<div class="bottom-grid">

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Calendar</h5>
        </div>
        <div class="card-body" style="min-height:220px;">
            <div id="datetimepicker-dashboard"></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Real-Time</h5>
        </div>
        <div class="card-body" style="min-height:220px;">
            <div id="world_map" style="height:100%; min-height:180px;"></div>
        </div>
    </div>

</div>

