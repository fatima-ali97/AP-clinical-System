@using AP_clinical_system.Services
@using AP_clinical_system.Models.sql_Context
@using Microsoft.AspNetCore.Identity;
@inject AP_Context _context;
@inject UserManager<AP_clinical_system.Models.Entities.system_user> UserManager


@{
    ViewBag.DevRole = "Patient"; // swap this to test different navs

    string initials = "?";

    if (User.Identity?.IsAuthenticated ?? false)
    {
        var currentUser = await UserManager.GetUserAsync(User);

        if (currentUser != null)
        {
            var first = !string.IsNullOrEmpty(currentUser.first_name)
                ? currentUser.first_name.Substring(0, 1).ToUpper()
                : "";

            var last = !string.IsNullOrEmpty(currentUser.last_name)
                ? currentUser.last_name.Substring(0, 1).ToUpper()
                : "";

            initials = first + last;

            if (string.IsNullOrEmpty(initials))
            {
                initials = "?";
            }
        }
    }
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="//cdnjs.cloudflare.com/ajax/libs/moment.js/2.5.1/moment.min.js"></script>
    <script src="https://kit.fontawesome.com/5544d11b5b.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/app/app.css">
    <title>@ViewData["Title"] - AdvancedHealth</title>

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --sidebar-w: 260px;
            --topbar-h: 60px;
            --sidebar-bg: #fff;
            --sidebar-text: #121212;
            --sidebar-text-active:#38789E;
            --sidebar-active-bg: rgba(186, 212, 213,0.4);
            --sidebar-active-border: #BAD4D5;
            --sidebar-header-color:#495057 ;
            --main-bg: #f5f7fb;
            --card-bg: #fff;
            --card-shadow: 0 0 14px 0 rgba(33,37,41,0.06);
            --topbar-bg: #fff;
            --topbar-shadow: 0 0 32px 0 rgba(33,37,41,0.1);
            --body-color: #495057;
            --muted: #6c757d;
            --border: #dee2e6;
            --primary: var(--color-brand-primary);
            --success: var(--color-green-400);
            --danger: var(--color-red-400);
            --warning: var(--color-yellow-400);
            --radius: 4px;
            --transition: 0.3s ease;
        }

        html, body { height: 100%; }
        body {
            font-family: 'Urbanist','Segoe UI', sans-serif;
            font-size: 0.875rem;
            color: var(--sidebar-text);
            background: var(--main-bg);
            overflow-x: hidden;
        }

        /* ── PAGE SHELL ── */
        .page-wrapper { display: flex; min-height: 100vh; }

        /* ── OVERLAY (mobile) ── */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 99;
        }
        .sidebar-overlay.active { display: block; }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--sidebar-bg);
            border: solid 0.9px rgba(186, 212, 213,0.5);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
            transition: transform var(--transition);
            overflow-y: auto;
            overflow-x: hidden;
        }
        .sidebar.collapsed { transform: translateX(calc(-1 * var(--sidebar-w))); }

        @@media (max-width: 991px) {
            .sidebar { transform: translateX(calc(-1 * var(--sidebar-w))); }
            .sidebar.open { transform: translateX(0); }
        }

        .sidebar-brand {
            padding: 1.1rem 1.5rem;
            color: var(--sidebar-text);
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            display: block;
            text-decoration: none;
            white-space: nowrap;
            margin-bottom: 2rem;
            border-bottom:     solid 0.9px rgba(186, 212, 213, 0.4)
        }

        .sidebar-nav { list-style: none; padding: 0; flex: 1; }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.9rem 1.625rem;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            border-left: 3px solid transparent;
            transition: background var(--transition), color var(--transition);
            white-space: nowrap;
        }
        .sidebar-link:hover { color: var(--primary);  }

        
        .sidebar-item.active > .sidebar-link {
            color: var(--sidebar-text-active);
            background: var(--sidebar-active-bg);
            border-left-color: var(--sidebar-active-border);
        }
        .logout-btn{
            margin: 40px 10px;
            background-color: var(--color-brand-primary);
            text-align: center;
            border-radius: var(--radius);
            display: flex;
               justify-content: center;
    align-items: center;
        }
        .logout-btn a, .logout-btn .sidebar-link:hover{
            text-align: center;
            color: #f1f3f7;
            transition: background var(--transition), color var(--transition);

        }
        .logout-btn:hover{
            transition: background var(--transition), color var(--transition);
            background-color: var(--color-brand-hover);
        }
        /* ── MAIN AREA ── */
        .main-area {
            flex: 1;
            margin-left: var(--sidebar-w);
            display: flex;
            flex-direction: column;
            min-width: 0;
            transition: margin-left var(--transition);
        }
        .main-area.expanded { margin-left: 0; }

        @@media (max-width: 991px) {
            .main-area { margin-left: 0; }
        }

        /* ── TOPBAR ── */
        .topbar {
            height: var(--topbar-h);
            background: var(--topbar-bg);
            box-shadow: var(--topbar-shadow);
            border: solid 0.9px rgba(186, 212, 213,0.4);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            gap: 1rem;
            position: sticky;
            top: 0;
            z-index: 999 !important;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex-shrink: 0;
        }
        .sidebar-toggle span {
            display: block;
            height: 2px;
            background: var(--body-color);
            border-radius: 2px;
            transition: background var(--transition);
        }
        .sidebar-toggle span:nth-child(1) { width: 22px; }
        .sidebar-toggle span:nth-child(2) { width: 22px; }
        .sidebar-toggle span:nth-child(3) { width: 14px; }
        .sidebar-toggle:hover span { background: var(--primary); }

        .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }

        .nav-icon-btn {
            position: relative;
            width: 36px; height: 36px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%;
            color: var(--muted);
            cursor: pointer;
            transition: color var(--transition), background var(--transition);
            text-decoration: none;
        }
        .nav-icon-btn:hover { color: var(--sidebar-active-border); }
        .nav-icon-btn svg { width: 20px; height: 20px; }
        .nav-icon-btn .badge-dot {
            position: absolute;
            top: 4px; right: 4px;
            width: 8px; height: 8px;
            background: var(--primary);
            border-radius: 50%;
            border: 2px solid #fff;
            font-size: 0; line-height: 0;
        }

        .user-pill {
            display: flex; align-items: center; gap: 8px;
            padding: 4px 8px;
            border-radius: 20px;
            cursor: pointer;
            transition: background var(--transition);
            color: var(--body-color);
            text-decoration: none;
        }
        .user-pill:hover { background: #f5f7fb; }
        .user-pill img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
        .user-pill-avatar {
            width: 32px; height: 32px;
            border-radius: 50%;
            background: var(--primary);
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            display: flex; align-items: center; justify-content: center;
        }
        .user-pill span { font-size: 0.8rem; font-weight: 500; }
        @@media (max-width: 575px) { .user-pill span { display: none; } }

        /* ── CONTENT AREA ── */
        .content {
            padding: 1.75rem 1.75rem 1rem;
            flex: 1;
        }
        @@media (max-width: 767px) { .content { padding: 1.25rem 1rem; } }

        /* ── FOOTER ── */
        .footer {
            padding: 0.875rem 1.75rem;
            background: #fff;
            border-top: 1px solid var(--border);
            font-size: 0.8rem;
            color: var(--muted);
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        .footer a { color: var(--primary); text-decoration: none; }
        .footer a:hover { text-decoration: underline; }
        .footer-links { margin-left: auto; display: flex; gap: 1rem; flex-wrap: wrap; }

        /* ── SHARED COMPONENT STYLES ── */
        .card {
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 1.25rem;
        }
        .card-body { padding: 1.25rem; }
        .card-header {
            padding: 0.8rem 1.25rem;
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
        }
        .card-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: #939ba2;
            margin: 0;
            
            letter-spacing: 0.04em;
        }

        .stat-card-inner { display: flex; justify-content: space-between; align-items: flex-start; }
        .stat-label { font-size: 0.75rem; font-weight: 500; color: #212529;  letter-spacing: 0.04em; }
        .stat-value { font-size: 1.8rem; font-weight: 700; color: #212529; margin: 0.25rem 0 ; line-height: 1; }
       
        .stat-icon {
            width: 44px; height: 44px;
            border-radius: 50%;
            background: var(--color-steel-100);
            display: flex; align-items: center; justify-content: center;
            color: var(--primary);
            flex-shrink: 0;
        }
        .stat-icon svg, .stat-icon img { width: 22px; height: 22px; }

        .stat-grid.admin {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }
        
        .stat-grid.patient{

        }
        .card-body img{
            width: 100%;
            height: 200px;
            margin: 0;padding: 0;
        }
        @@media (max-width: 1199px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 575px)  { .stat-grid { grid-template-columns: 1fr; } }

        .bottom-grid {
            display: grid;
            grid-template-columns: 0.6fr 1fr;
            gap: 1.25rem;
            margin-bottom: 1.25rem;
        }
        .bottom-grid.patient{
            display: grid;
            grid-template-columns: 0.3fr 0.4fr 0.3fr;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }
        @@media (max-width: 991px) { .bottom-grid { grid-template-columns: 1fr; } }

        .page-heading {
            font-size: 1.3rem;
            font-weight: 600;
            color: #212529;
            margin-bottom: 1.5rem;
        }
        

        .text-success { color: var(--success) !important; }
        .text-danger  { color: var(--danger)  !important; }
        .text-muted   { color: var(--muted)   !important; }

        .badge {
            display: inline-block;
            padding: 0.28em 0.6em;
            font-size: 0.74rem;
            font-weight: 600;
            border-radius: 3px;
            line-height: 1.4;
            white-space: nowrap;
        }
        .badge-success { background: var(--success); color: #fff; }
        .badge-danger  { background: var(--danger);  color: #fff; }
        .badge-warning { background: var(--warning); color: #212529; }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table thead th {
            padding: 0.75rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }
        .data-table tbody td {
            padding: 0.75rem;
            font-size: 0.875rem;
            border-bottom: 1px solid #f1f3f7;
            vertical-align: middle;
        }
        .data-table tbody tr:last-child td { border-bottom: none; }
        .data-table tbody tr:hover td { background: #fafbfc; }

        .d-none-sm { display: table-cell; }
        @@media (max-width: 991px) { .d-none-sm { display: none !important; } }
        .d-none-xs { display: table-cell; }
        @@media (max-width: 767px) { .d-none-xs { display: none !important; } }
.stat-card {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
   
}

  .stat-card::before,
  .stat-card::after,
  .stat-card .tri-bl {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    border-style: solid;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
  }
  .stat-card::before {
    top: 0; left: 0;
    border-width: 110px 110px 0 0;
    border-color: rgba(255,255,255,0.18) transparent transparent transparent;
    transform-origin: top left;
    transform: rotate(0deg);
  }
  .stat-card::after {
    bottom: 0; right: 0;
    border-width: 0 0 110px 110px;
    border-color: transparent transparent rgba(255,255,255,0.18) transparent;
    transform-origin: bottom right;
    transform: rotate(0deg);
  }
  .stat-card .tri-bl {
    bottom: 0; left: 0;
    border-width: 0 110px 110px 0;
    border-color: transparent rgba(255,255,255,0.13) transparent transparent;
    transform-origin: bottom left;
    transform: rotate(0deg);
  }
  .stat-card:hover::before {
   transform:  translateX(-50px) ;
    opacity: 0.6;
  }
  .stat-card:hover::after {
    transform:  translateX(30px) ;
    opacity: 0.6;
  }
  .stat-card:hover .tri-bl {
    transform: rotate(90deg);
    opacity: 0;
  }
    </style>
</head>
<body>



<div class="page-wrapper">

    <!-- Mobile overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ── SIDEBAR ── -->
    <nav class="sidebar" id="sidebar">

        <a class="sidebar-brand" href="/">AdvancedHealth</a>

        
        @await Html.PartialAsync("_Navigation")

        <div class="logout-btn">
            <a class="sidebar-link" asp-controller="Account" asp-action="Logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
            </a>
        </div>

    </nav>

    <!-- ── MAIN AREA ── -->
    <div class="main-area" id="mainArea">

        <!-- Topbar -->
        <header class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                <span></span><span></span><span></span>
            </button>

            <div class="topbar-right">
                @* Notification bell TODO: to be decided later
                <a class="nav-icon-btn" href="#" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <span class="badge-dot"></span>
                </a>
                *@
                 <a class="user-pill" href="#">
                    <div class="user-pill-avatar">
                        @initials
                    </div>
                 </a>
            </div>
        </header>

        <!-- Page content -->
        <main class="content">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="footer">
            <span>&copy; @DateTime.Now.Year <a href="#">AdvancedHealth</a></span>
            <div class="footer-links">
                @* <a href="#">Support</a> *@
            </div>
        </footer>

    </div><!-- /main-area -->
</div><!-- /page-wrapper -->


<script>
(function () {
    var sidebar  = document.getElementById('sidebar');
    var mainArea = document.getElementById('mainArea');
    var toggle   = document.getElementById('sidebarToggle');
    var overlay  = document.getElementById('sidebarOverlay');
    var isMobile = function () { return window.innerWidth < 992; };

    function openSidebar() {
        if (isMobile()) {
            sidebar.classList.add('open');
            overlay.classList.add('active');
        } else {
            sidebar.classList.remove('collapsed');
            mainArea.classList.remove('expanded');
        }
    }

    function closeSidebar() {
        if (isMobile()) {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        } else {
            sidebar.classList.add('collapsed');
            mainArea.classList.add('expanded');
        }
    }

    function isOpen() {
        return isMobile()
            ? sidebar.classList.contains('open')
            : !sidebar.classList.contains('collapsed');
    }

    toggle.addEventListener('click', function () {
        isOpen() ? closeSidebar() : openSidebar();
    });

    overlay.addEventListener('click', closeSidebar);

    window.addEventListener('resize', function () {
        if (!isMobile()) {
            overlay.classList.remove('active');
            sidebar.classList.remove('open');
        }
    });
})();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
