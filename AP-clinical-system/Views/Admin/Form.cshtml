@{
    Layout = null;
    var entities = (Dictionary<string, string>)ViewBag.Entities;
    var currentEntity = (string)ViewBag.EntityName;
    var recordId = (string)ViewBag.RecordId;
    var isNew = string.IsNullOrEmpty(recordId);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isNew ? "New" : "Edit") @currentEntity - Admin Panel</title>
    <link rel="stylesheet" href="~/css/admin/admin.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="admin-body">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="admin-sidebar-header">
            <i class="fas fa-database"></i>
            <span>Admin Panel</span>
        </div>
        <nav class="admin-sidebar-nav">
            @foreach (var entity in entities)
            {
                var isActive = entity.Key == currentEntity ? "active" : "";
                <a href="/admin/@entity.Key" class="admin-sidebar-link @isActive">
                    <i class="fas fa-table"></i>
                    <span>@entity.Key.Replace("_", " ")</span>
                </a>
            }
        </nav>
        <div class="admin-sidebar-footer">
            <a href="/admin/logout" class="admin-sidebar-link logout">
                <i class="fas fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <!-- Toolbar -->
        <div class="admin-toolbar">
            <div class="admin-toolbar-title">
                <button class="admin-sidebar-toggle" id="sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <a href="/admin/@currentEntity" class="admin-btn admin-btn-ghost" id="btn-back">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h2><i class="fas fa-@(isNew ? "plus-circle" : "pen-to-square")"></i> @(isNew ? "New" : "Edit") @currentEntity.Replace("_", " ")</h2>
            </div>
            <div class="admin-toolbar-actions">
                <button class="admin-btn admin-btn-primary" id="btn-save">
                    <i class="fas fa-floppy-disk"></i> Save
                </button>
                <button class="admin-btn admin-btn-success" id="btn-save-new">
                    <i class="fas fa-floppy-disk"></i> Save & New
                </button>
                @if (!isNew)
                {
                    <button class="admin-btn admin-btn-danger" id="btn-delete">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                }
                <button class="admin-btn admin-btn-secondary" id="btn-refresh">
                    <i class="fas fa-refresh"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Form -->
        <div class="admin-form-container">
            <div class="admin-loading" id="loading-indicator" @(isNew ? "style=display:none;" : "")>
                <div class="admin-spinner"></div>
                <span>Loading data...</span>
            </div>
            <form id="entity-form" class="admin-entity-form" style="@(isNew ? null : "display:none")">
                <!-- Fields generated dynamically -->
            </form>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div class="admin-modal-overlay" id="modal-overlay" style="display:none;">
        <div class="admin-modal">
            <div class="admin-modal-header">
                <i class="fas fa-exclamation-triangle"></i>
                <h3>Confirm Deletion</h3>
            </div>
            <div class="admin-modal-body">
                <p>Are you sure you want to delete this record? This action cannot be undone.</p>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-secondary" id="modal-cancel">Cancel</button>
                <button class="admin-btn admin-btn-danger" id="modal-confirm">Delete</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="admin-toast" id="toast" style="display:none;"></div>

    <script>
        const ENTITY = "@currentEntity";
        const RECORD_ID = "@recordId";
        const IS_NEW = @(isNew ? "true" : "false");
        const API_BASE = `/admin/api/${ENTITY}`;
        let schema = [];

        document.addEventListener('DOMContentLoaded', async () => {
            await loadSchema();
            if (!IS_NEW) {
                await loadRecord();
            } else {
                buildForm({});
            }
            bindEvents();
        });

        async function loadSchema() {
            const res = await fetch(`${API_BASE}/schema`);
            schema = await res.json();
        }

        async function loadRecord() {
            showLoading(true);
            try {
                const res = await fetch(`${API_BASE}/${RECORD_ID}`);
                if (!res.ok) throw new Error('Not found');
                const data = await res.json();
                buildForm(data);
            } catch (e) {
                showToast('Failed to load record', 'error');
            }
            showLoading(false);
        }

        function buildForm(data) {
            const form = document.getElementById('entity-form');
            form.style.display = 'grid';
            let html = '';

            for (const col of schema) {
                const val = data[col.name];
                const readOnly = col.name === 'id' && !IS_NEW;
                const isSystemField = ['id', 'createdon', 'createdby', 'modifiedon', 'modifiedby'].includes(col.name);

                html += `<div class="admin-field-group ${isSystemField ? 'system-field' : ''}">`;
                html += `<label for="field-${col.name}">${col.name.replace(/_/g, ' ')}</label>`;
                html += getInputHtml(col, val, readOnly);
                html += '</div>';
            }

            form.innerHTML = html;
        }

        function getInputHtml(col, val, readOnly) {
            const id = `field-${col.name}`;
            const name = col.name;
            const ro = readOnly ? 'readonly' : '';
            const disabledClass = readOnly ? 'admin-input-readonly' : '';

            if (col.type === 'bool') {
                const checked = val === true ? 'checked' : '';
                return `<label class="admin-switch">
                    <input type="checkbox" id="${id}" name="${name}" ${checked} />
                    <span class="admin-switch-slider"></span>
                    <span class="admin-switch-label">${val === true ? 'Yes' : 'No'}</span>
                </label>`;
            }

            if (col.type === 'datetime') {
                let formatted = '';
                if (val) {
                    try {
                        const d = new Date(val);
                        formatted = d.toISOString().slice(0, 16);
                    } catch {}
                }
                return `<input type="datetime-local" id="${id}" name="${name}" value="${formatted}" class="${disabledClass}" ${ro} />`;
            }

            if (col.type === 'date') {
                let formatted = val || '';
                return `<input type="date" id="${id}" name="${name}" value="${formatted}" class="${disabledClass}" ${ro} />`;
            }

            if (col.type === 'time') {
                let formatted = val || '';
                return `<input type="time" id="${id}" name="${name}" value="${formatted}" class="${disabledClass}" ${ro} />`;
            }

            if (col.type === 'int' || col.type === 'long') {
                const v = val !== null && val !== undefined ? val : '';
                return `<input type="number" id="${id}" name="${name}" value="${v}" class="${disabledClass}" ${ro} />`;
            }

            if (col.type === 'decimal' || col.type === 'double' || col.type === 'float') {
                const v = val !== null && val !== undefined ? val : '';
                return `<input type="number" step="any" id="${id}" name="${name}" value="${v}" class="${disabledClass}" ${ro} />`;
            }

            if (col.type === 'guid') {
                const v = val || '';
                return `<input type="text" id="${id}" name="${name}" value="${v}" class="${disabledClass}" ${ro} placeholder="GUID" />`;
            }

            // Default: string / text
            const v = val !== null && val !== undefined ? escapeAttr(String(val)) : '';
            if (v.length > 100) {
                return `<textarea id="${id}" name="${name}" rows="3" class="${disabledClass}" ${ro}>${escapeHtml(String(val))}</textarea>`;
            }
            return `<input type="text" id="${id}" name="${name}" value="${v}" class="${disabledClass}" ${ro} />`;
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function escapeAttr(str) {
            return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function collectFormData() {
            const data = {};
            for (const col of schema) {
                const el = document.getElementById(`field-${col.name}`);
                if (!el) continue;

                if (col.type === 'bool') {
                    data[col.name] = el.checked;
                } else if (col.type === 'int' || col.type === 'long') {
                    data[col.name] = el.value !== '' ? parseInt(el.value) : null;
                } else if (col.type === 'decimal' || col.type === 'double' || col.type === 'float') {
                    data[col.name] = el.value !== '' ? parseFloat(el.value) : null;
                } else {
                    data[col.name] = el.value || null;
                }
            }
            return data;
        }

        // ── Events ──
        function bindEvents() {
            document.getElementById('btn-save').addEventListener('click', () => saveRecord(false));
            document.getElementById('btn-save-new').addEventListener('click', () => saveRecord(true));
            document.getElementById('btn-refresh').addEventListener('click', () => {
                if (IS_NEW) { buildForm({}); }
                else { loadRecord(); }
            });

            const btnDelete = document.getElementById('btn-delete');
            if (btnDelete) {
                btnDelete.addEventListener('click', showDeleteModal);
            }

            document.getElementById('sidebar-toggle').addEventListener('click', () => {
                document.getElementById('admin-sidebar').classList.toggle('collapsed');
                document.querySelector('.admin-main').classList.toggle('expanded');
            });

            // Toggle switch labels
            document.addEventListener('change', (e) => {
                if (e.target.closest('.admin-switch')) {
                    const label = e.target.closest('.admin-switch').querySelector('.admin-switch-label');
                    if (label) label.textContent = e.target.checked ? 'Yes' : 'No';
                }
            });
        }

        async function saveRecord(andNew) {
            const data = collectFormData();
            try {
                const res = await fetch(`${API_BASE}/save`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.success) {
                    showToast('Record saved successfully', 'success');
                    if (andNew) {
                        window.location.href = `/admin/${ENTITY}/new`;
                    } else if (IS_NEW) {
                        // Redirect to edit form of saved record
                        window.location.href = `/admin/${ENTITY}/${result.id}`;
                    }
                } else {
                    showToast('Failed to save', 'error');
                }
            } catch (e) {
                showToast('Failed to save: ' + e.message, 'error');
            }
        }

        function showDeleteModal() {
            document.getElementById('modal-overlay').style.display = 'flex';
            document.getElementById('modal-cancel').onclick = () => {
                document.getElementById('modal-overlay').style.display = 'none';
            };
            document.getElementById('modal-confirm').onclick = async () => {
                document.getElementById('modal-overlay').style.display = 'none';
                try {
                    const res = await fetch(`${API_BASE}/delete`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ids: [RECORD_ID] })
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Record deleted', 'success');
                        setTimeout(() => { window.location.href = `/admin/${ENTITY}`; }, 500);
                    }
                } catch (e) {
                    showToast('Failed to delete', 'error');
                }
            };
        }

        function showLoading(show) {
            document.getElementById('loading-indicator').style.display = show ? 'flex' : 'none';
            if (show) document.getElementById('entity-form').style.display = 'none';
        }

        function showToast(msg, type) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.className = `admin-toast admin-toast-${type}`;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }
    </script>
</body>
</html>
