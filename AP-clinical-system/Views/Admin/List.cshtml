@{
    Layout = null;
    var entities = (Dictionary<string, string>)ViewBag.Entities;
    var currentEntity = (string)ViewBag.EntityName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@currentEntity - Admin Panel</title>
    <link rel="stylesheet" href="~/css/admin/admin.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="admin-body">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="admin-sidebar">
        <div class="admin-sidebar-header">
            <i class="fas fa-database"></i>
            <span>Admin Panel</span>
        </div>
        <nav class="admin-sidebar-nav">
            @foreach (var entity in entities)
            {
                var isActive = entity.Key == currentEntity ? "active" : "";
                <a href="/admin/@entity.Key" class="admin-sidebar-link @isActive">
                    <i class="fas fa-table"></i>
                    <span>@entity.Key.Replace("_", " ")</span>
                </a>
            }
        </nav>
        <div class="admin-sidebar-footer">
            <a href="/admin/logout" class="admin-sidebar-link logout">
                <i class="fas fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-main">
        <!-- Toolbar -->
        <div class="admin-toolbar">
            <div class="admin-toolbar-title">
                <button class="admin-sidebar-toggle" id="sidebar-toggle">
                    <i class="fas fa-bars"></i>
                </button>
                <h2><i class="fas fa-table"></i> @currentEntity.Replace("_", " ")</h2>
            </div>
            <div class="admin-toolbar-actions">
                <a href="/admin/@currentEntity/new" class="admin-btn admin-btn-primary" id="btn-add">
                    <i class="fas fa-plus"></i> Add
                </a>
                <button class="admin-btn admin-btn-success" id="btn-activate" disabled>
                    <i class="fas fa-check-circle"></i> Activate
                </button>
                <button class="admin-btn admin-btn-warning" id="btn-deactivate" disabled>
                    <i class="fas fa-ban"></i> Deactivate
                </button>
                <button class="admin-btn admin-btn-danger" id="btn-delete" disabled>
                    <i class="fas fa-trash"></i> Delete
                </button>
                <button class="admin-btn admin-btn-secondary" id="btn-refresh">
                    <i class="fas fa-refresh"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Data Table -->
        <div class="admin-table-container">
            <div class="admin-loading" id="loading-indicator">
                <div class="admin-spinner"></div>
                <span>Loading data...</span>
            </div>
            <div class="admin-table-wrapper" id="table-wrapper" style="display:none;">
                <table class="admin-table" id="data-table">
                    <thead id="table-head"></thead>
                    <tbody id="table-body"></tbody>
                </table>
            </div>
            <div class="admin-empty" id="empty-state" style="display:none;">
                <i class="fas fa-inbox"></i>
                <p>No records found</p>
            </div>
        </div>
    </main>

    <!-- Delete Confirmation Modal -->
    <div class="admin-modal-overlay" id="modal-overlay" style="display:none;">
        <div class="admin-modal">
            <div class="admin-modal-header">
                <i class="fas fa-exclamation-triangle"></i>
                <h3>Confirm Deletion</h3>
            </div>
            <div class="admin-modal-body">
                <p id="modal-message">Are you sure you want to delete the selected record(s)? This action cannot be undone.</p>
            </div>
            <div class="admin-modal-footer">
                <button class="admin-btn admin-btn-secondary" id="modal-cancel">Cancel</button>
                <button class="admin-btn admin-btn-danger" id="modal-confirm">Delete</button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="admin-toast" id="toast" style="display:none;"></div>

    <script>
        const ENTITY = "@currentEntity";
        const API_BASE = `/admin/api/${ENTITY}`;
        let schema = [];
        let allData = [];
        let selectedIds = new Set();

        // ─── Init ──────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', async () => {
            await loadSchema();
            await loadData();
            bindEvents();
        });

        async function loadSchema() {
            const res = await fetch(`${API_BASE}/schema`);
            schema = await res.json();
        }

        async function loadData() {
            showLoading(true);
            selectedIds.clear();
            updateToolbarState();
            try {
                const res = await fetch(`${API_BASE}/list`);
                allData = await res.json();
                renderTable();
            } catch (e) {
                showToast('Failed to load data', 'error');
            }
            showLoading(false);
        }

        function renderTable() {
            const thead = document.getElementById('table-head');
            const tbody = document.getElementById('table-body');
            const wrapper = document.getElementById('table-wrapper');
            const empty = document.getElementById('empty-state');

            if (allData.length === 0) {
                wrapper.style.display = 'none';
                empty.style.display = 'flex';
                return;
            }

            wrapper.style.display = 'block';
            empty.style.display = 'none';

            // Head
            let headHtml = '<tr><th class="admin-th-check"><input type="checkbox" id="select-all" /></th>';
            for (const col of schema) {
                headHtml += `<th>${col.name.replace(/_/g, ' ')}</th>`;
            }
            headHtml += '</tr>';
            thead.innerHTML = headHtml;

            // Body
            let bodyHtml = '';
            for (const row of allData) {
                const id = row.id;
                const checked = selectedIds.has(id) ? 'checked' : '';
                bodyHtml += `<tr data-id="${id}">`;
                bodyHtml += `<td class="admin-td-check"><input type="checkbox" class="row-check" data-id="${id}" ${checked} /></td>`;
                for (const col of schema) {
                    const val = row[col.name];
                    const display = formatValue(val, col.type);
                    if (col.name === 'id') {
                        bodyHtml += `<td><a href="/admin/${ENTITY}/${id}" class="admin-pk-link">${display}</a></td>`;
                    } else {
                        bodyHtml += `<td>${display}</td>`;
                    }
                }
                bodyHtml += '</tr>';
            }
            tbody.innerHTML = bodyHtml;

            // Bind checkbox events
            document.getElementById('select-all').addEventListener('change', (e) => {
                const checks = document.querySelectorAll('.row-check');
                checks.forEach(ch => {
                    ch.checked = e.target.checked;
                    if (e.target.checked) selectedIds.add(ch.dataset.id);
                    else selectedIds.delete(ch.dataset.id);
                });
                updateToolbarState();
            });

            document.querySelectorAll('.row-check').forEach(ch => {
                ch.addEventListener('change', (e) => {
                    if (e.target.checked) selectedIds.add(e.target.dataset.id);
                    else selectedIds.delete(e.target.dataset.id);
                    updateToolbarState();
                });
            });
        }

        function formatValue(val, type) {
            if (val === null || val === undefined) return '<span class="admin-null">null</span>';
            if (type === 'bool') return val ? '<span class="admin-badge admin-badge-green">true</span>' : '<span class="admin-badge admin-badge-red">false</span>';
            if (type === 'datetime') {
                try {
                    const d = new Date(val);
                    return d.toLocaleString();
                } catch { return val; }
            }
            if (type === 'guid') return `<span class="admin-guid">${String(val).substring(0, 8)}…</span>`;
            return escapeHtml(String(val));
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function updateToolbarState() {
            const hasSelection = selectedIds.size > 0;
            document.getElementById('btn-activate').disabled = !hasSelection;
            document.getElementById('btn-deactivate').disabled = !hasSelection;
            document.getElementById('btn-delete').disabled = !hasSelection;
        }

        function showLoading(show) {
            document.getElementById('loading-indicator').style.display = show ? 'flex' : 'none';
            if (show) {
                document.getElementById('table-wrapper').style.display = 'none';
                document.getElementById('empty-state').style.display = 'none';
            }
        }

        // ─── Events ────────────────────────────────────────────
        function bindEvents() {
            document.getElementById('btn-refresh').addEventListener('click', loadData);

            document.getElementById('btn-activate').addEventListener('click', () => setInactive(false));
            document.getElementById('btn-deactivate').addEventListener('click', () => setInactive(true));
            document.getElementById('btn-delete').addEventListener('click', () => showDeleteModal());

            // Sidebar toggle
            document.getElementById('sidebar-toggle').addEventListener('click', () => {
                document.getElementById('admin-sidebar').classList.toggle('collapsed');
                document.querySelector('.admin-main').classList.toggle('expanded');
            });
        }

        async function setInactive(value) {
            const ids = Array.from(selectedIds);
            const action = value ? 'deactivate' : 'activate';
            try {
                const res = await fetch(`${API_BASE}/set-inactive`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, value })
                });
                const result = await res.json();
                showToast(`${result.updated} record(s) ${action}d`, 'success');
                await loadData();
            } catch (e) {
                showToast(`Failed to ${action}`, 'error');
            }
        }

        function showDeleteModal() {
            const count = selectedIds.size;
            document.getElementById('modal-message').textContent =
                `Are you sure you want to delete ${count} record(s)? This action cannot be undone.`;
            document.getElementById('modal-overlay').style.display = 'flex';

            document.getElementById('modal-cancel').onclick = () => {
                document.getElementById('modal-overlay').style.display = 'none';
            };
            document.getElementById('modal-confirm').onclick = async () => {
                document.getElementById('modal-overlay').style.display = 'none';
                await deleteSelected();
            };
        }

        async function deleteSelected() {
            const ids = Array.from(selectedIds);
            try {
                const res = await fetch(`${API_BASE}/delete`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids })
                });
                const result = await res.json();
                showToast(`${result.deleted} record(s) deleted`, 'success');
                await loadData();
            } catch (e) {
                showToast('Failed to delete', 'error');
            }
        }

        function showToast(msg, type) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.className = `admin-toast admin-toast-${type}`;
            toast.style.display = 'block';
            setTimeout(() => { toast.style.display = 'none'; }, 3000);
        }
    </script>
</body>
</html>
